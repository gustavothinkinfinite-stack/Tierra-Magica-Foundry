<form class="{{cssClass}} tm-item-sheet" autocomplete="off">
  <header class="tm-item-header">
    <img src="{{item.img}}" data-edit="img" title="{{item.name}}" />
    <div><span class="tm-kicker">{{typeLabel}}</span><input name="name" type="text" value="{{item.name}}" placeholder="Nombre" /></div>
  </header>

  <section class="tm-panel tm-item-fields">
    <div class="tm-form-grid">
      {{#if isWeapon}}
        <label><span>Característica de ataque</span><select name="system.attackAbility">{{selectOptions config.abilities selected=system.attackAbility}}</select></label>
        <label><span>Bono de ataque</span><input type="number" name="system.attackBonus" value="{{system.attackBonus}}" /></label>
        <label><span>Daño</span><input type="text" name="system.damage" value="{{system.damage}}" placeholder="1d8" /></label>
        <label><span>Característica de daño</span><select name="system.damageAbility">{{selectOptions config.abilities selected=system.damageAbility}}</select></label>
        <label><span>Bono de daño</span><input type="number" name="system.damageBonus" value="{{system.damageBonus}}" /></label>
        <label><span>Manos</span><input type="number" name="system.hands" value="{{system.hands}}" min="0" max="2" /></label>
        <label><span>Alcance</span><input type="text" name="system.range" value="{{system.range}}" /></label>
        <label><span>Rasgos</span><input type="text" name="system.traits" value="{{system.traits}}" /></label>
      {{/if}}
      {{#if isArmor}}
        <label><span>Armadura</span><input type="number" name="system.armor" value="{{system.armor}}" /></label>
        <label><span>Resistencia mágica</span><input type="number" name="system.magicResistance" value="{{system.magicResistance}}" /></label>
        <label><span>Penalizador</span><input type="number" name="system.penalty" value="{{system.penalty}}" /></label>
        <label><span>Rasgos</span><input type="text" name="system.traits" value="{{system.traits}}" /></label>
      {{/if}}
      {{#if isEquipment}}
        <label><span>Categoría</span><input type="text" name="system.category" value="{{system.category}}" /></label>
      {{/if}}
      {{#if isSpell}}
        <label><span>Nivel</span><input type="text" name="system.level" value="{{system.level}}" /></label>
        <label><span>Coste de Maná</span><input type="number" name="system.cost" value="{{system.cost}}" min="0" /></label>
        <label><span>Salvación</span><input type="text" name="system.saving" value="{{system.saving}}" /></label>
        <label><span>Requisitos</span><input type="text" name="system.requirements" value="{{system.requirements}}" /></label>
        <label><span>Tirada o daño</span><input type="text" name="system.roll" value="{{system.roll}}" placeholder="1d20 + 5" /></label>
        <label><span>Rasgos</span><input type="text" name="system.traits" value="{{system.traits}}" /></label>
        <label class="tm-check"><span>Consumir Maná al lanzar</span><input type="checkbox" name="system.consumeOnUse" {{checked system.consumeOnUse}} /></label>
      {{/if}}
      {{#if isTalent}}
        <label><span>Categoría</span><input type="text" name="system.category" value="{{system.category}}" /></label>
        <label><span>Requisitos</span><input type="text" name="system.requirements" value="{{system.requirements}}" /></label>
        <label><span>Coste de Maná</span><input type="number" name="system.manaCost" value="{{system.manaCost}}" min="0" /></label>
      {{/if}}
      {{#if isFamiliarBenefit}}
        <label><span>Coste de beneficio</span><input type="number" name="system.cost" value="{{system.cost}}" min="0" /></label>
        <label><span>Requisitos</span><input type="text" name="system.requirements" value="{{system.requirements}}" /></label>
        <label><span>Efecto resumido</span><input type="text" name="system.effect" value="{{system.effect}}" /></label>
      {{/if}}
      <label><span>Cantidad</span><input type="number" name="system.quantity" value="{{system.quantity}}" min="0" /></label>
      <label><span>Peso</span><input type="number" name="system.weight" value="{{system.weight}}" min="0" step="0.1" /></label>
      <label><span>Precio</span><input type="number" name="system.price" value="{{system.price}}" min="0" step="0.1" /></label>
      {{#unless isSpell}}{{#unless isTalent}}{{#unless isFamiliarBenefit}}<label class="tm-check"><span>Equipado</span><input type="checkbox" name="system.equipped" {{checked system.equipped}} /></label>{{/unless}}{{/unless}}{{/unless}}
    </div>
  </section>
  <section class="tm-panel tm-editor-panel"><h2>Descripción</h2>{{editor enrichedDescription target="system.description" button=true editable=editable engine="prosemirror" collaborate=false}}</section>
</form>
