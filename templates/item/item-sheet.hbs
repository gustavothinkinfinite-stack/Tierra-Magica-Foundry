<form class="{{cssClass}} tm-item-sheet" autocomplete="off">
  <header class="tm-item-header">
    <img src="{{item.img}}" data-edit="img" title="{{item.name}}" />
    <div><span class="tm-kicker">{{typeLabel}} · Foundry T.M.</span><input name="name" type="text" value="{{item.name}}" placeholder="Nombre" /></div>
  </header>

  <section class="tm-panel tm-item-fields">
    <div class="tm-section-heading"><h2>Identidad estructurada</h2><span>{{acquisitionDisplay}}</span></div>
    <div class="tm-form-grid">
      <label><span>Slug mecánico</span><input type="text" name="system.slug" value="{{system.slug}}" /></label>
      <label><span>Stacking</span><select name="system.stacking">{{selectOptions config.stackingModes selected=system.stacking}}</select></label>
      <label><span>Requisitos narrativos / acceso</span><input type="text" name="system.requirementsText" value="{{system.requirementsText}}" /></label>
    </div>
  </section>

  <section class="tm-panel tm-item-fields">
    <div class="tm-form-grid">
      {{#if isWeapon}}
        <label><span>Habilidad</span><select name="system.skill">{{selectOptions config.weaponSkillLabels selected=system.skill}}</select></label>
        <label><span>Atributo de ataque</span><select name="system.attackAttribute">{{selectOptions config.attributes selected=system.attackAttribute}}</select></label>
        <label><span>Atributo al daño</span><select name="system.damageAttribute"><option value="">Ninguno</option>{{selectOptions config.attributes selected=system.damageAttribute}}</select></label>
        <label><span>Daño base</span><input type="number" name="system.damage" value="{{system.damage}}" min="0" /></label>
        <label><span>Penetración</span><input type="number" name="system.penetration" value="{{system.penetration}}" min="0" /></label>
        <label><span>FUE mínima</span><input type="number" name="system.strengthMin" value="{{system.strengthMin}}" min="0" /></label>
        <label><span>Alcance óptimo (esp.)</span><input type="number" name="system.rangeOptimal" value="{{system.rangeOptimal}}" min="0" /></label>
        <label><span>Consecuencia grave</span><input type="text" name="system.severe" value="{{system.severe}}" /></label>
      {{/if}}

      {{#if isArmor}}
        <label><span>Protección</span><input type="number" name="system.protection" value="{{system.protection}}" min="0" /></label>
        <label><span>FUE mínima</span><input type="number" name="system.strengthMin" value="{{system.strengthMin}}" min="0" /></label>
      {{/if}}

      {{#if isShield}}
        <label><span>Defensa pasiva</span><input type="number" name="system.passiveDefense" value="{{system.passiveDefense}}" min="0" /></label>
        <label><span>Bloqueo</span><input type="number" name="system.block" value="{{system.block}}" min="0" /></label>
        <label><span>FUE mínima</span><input type="number" name="system.strengthMin" value="{{system.strengthMin}}" min="0" /></label>
        <label class="tm-check"><span>Solo frontal</span><input type="checkbox" name="system.frontalOnly" {{checked system.frontalOnly}} /></label>
      {{/if}}

      {{#if isEquipment}}
        <label><span>Categoría</span><input type="text" name="system.category" value="{{system.category}}" /></label>
      {{/if}}

      {{#if isSpell}}
        <label><span>Fuente</span><select name="system.source">{{selectOptions config.sources selected=system.source}}</select></label>
        <label><span>Disciplina</span><select name="system.discipline">{{selectOptions config.disciplines selected=system.discipline}}</select></label>
        <label><span>Método</span><select name="system.method">{{selectOptions config.spellMethods selected=system.method}}</select></label>
        <label><span>Coste de Maná</span><input type="number" name="system.manaCost" value="{{system.manaCost}}" min="0" /></label>
        <label><span>Atributo</span><select name="system.attribute">{{selectOptions config.attributes selected=system.attribute}}</select></label>
        <label><span>Defensa</span><select name="system.defense">
          <option value="df" {{#if (eq system.defense "df")}}selected{{/if}}>DF fija</option>
          <option value="normal" {{#if (eq system.defense "normal")}}selected{{/if}}>Defensa</option>
          <option value="mental" {{#if (eq system.defense "mental")}}selected{{/if}}>Defensa Mental</option>
          <option value="body" {{#if (eq system.defense "body")}}selected{{/if}}>Defensa Corporal</option>
        </select></label>
        <label><span>DF</span><input type="number" name="system.difficulty" value="{{system.difficulty}}" /></label>
        <label><span>Daño</span><input type="number" name="system.damage" value="{{system.damage}}" min="0" /></label>
        <label><span>Penetración</span><input type="number" name="system.penetration" value="{{system.penetration}}" min="0" /></label>
        <label><span>Alcance</span><input type="text" name="system.range" value="{{system.range}}" /></label>
        <label><span>Objetivos</span><select name="system.targetMode">
          <option value="single" {{#if (eq system.targetMode "single")}}selected{{/if}}>Único</option>
          <option value="multiple" {{#if (eq system.targetMode "multiple")}}selected{{/if}}>Múltiples</option>
          <option value="self" {{#if (eq system.targetMode "self")}}selected{{/if}}>Personal</option>
        </select></label>
        <label><span>Máx. objetivos</span><input type="number" name="system.maxTargets" value="{{system.maxTargets}}" min="1" /></label>
        <label class="tm-check"><span>Requiere objetivo</span><input type="checkbox" name="system.requiresTarget" {{checked system.requiresTarget}} /></label>
        <label><span>Requisitos</span><input type="text" name="system.requirementsText" value="{{system.requirementsText}}" placeholder="Requisitos narrativos o de acceso" /></label>
        <label class="tm-check"><span>Sostenido</span><input type="checkbox" name="system.sustained" {{checked system.sustained}} /></label>
        <label class="tm-check"><span>Compatible con Origen Remoto</span><input type="checkbox" name="system.remoteOriginCompatible" {{checked system.remoteOriginCompatible}} /></label>
      {{/if}}

      {{#if isTechnique}}
        <label><span>Grado</span><select name="system.grade">{{selectOptions config.techniqueGrades selected=system.grade}}</select></label>
        <label><span>Coste PD</span><input type="number" value="{{system.pdCost}}" disabled /></label>
        <label><span>Requisitos</span><input type="text" name="system.requirementsText" value="{{system.requirementsText}}" /></label>
        <label><span>Efecto</span><input type="text" name="system.effect" value="{{system.effect}}" /></label>
      {{/if}}

      {{#if isTrait}}
        <label><span>Categoría</span><select name="system.category">{{selectOptions config.traitCategories selected=system.category}}</select></label>
        <label><span>Coste de Rasgo</span><input type="number" value="{{system.traitCost}}" disabled /></label>
        <label><span>Requisitos</span><input type="text" name="system.requirementsText" value="{{system.requirementsText}}" /></label>
        <label><span>Efecto</span><input type="text" name="system.effect" value="{{system.effect}}" /></label>
      {{/if}}

      {{#if isSpecialization}}
        <label><span>Habilidad base</span><select name="system.skill"><option value="">Elegir</option>{{selectOptions config.skillLabels selected=system.skill}}</select></label>
        <label><span>Coste PD</span><input type="number" value="{{system.pdCost}}" disabled /></label>
        <label><span>Requisitos</span><input type="text" name="system.requirementsText" value="{{system.requirementsText}}" /></label>
        <label><span>Acceso / efecto</span><input type="text" name="system.effect" value="{{system.effect}}" /></label>
      {{/if}}

      {{#if isFormula}}
        <label><span>Grado</span><input type="text" name="system.grade" value="{{system.grade}}" /></label>
        <label><span>Coste PD</span><input type="number" value="{{system.pdCost}}" disabled /></label>
        <label><span>Preparación</span><input type="text" name="system.preparation" value="{{system.preparation}}" /></label>
        <label><span>Ingredientes</span><input type="text" name="system.ingredients" value="{{system.ingredients}}" /></label>
        <label><span>Tiempo</span><input type="text" name="system.time" value="{{system.time}}" /></label>
        <label><span>Dosis</span><input type="text" name="system.dose" value="{{system.dose}}" /></label>
        <label><span>Vía</span><input type="text" name="system.route" value="{{system.route}}" /></label>
        <label><span>Duración</span><input type="text" name="system.duration" value="{{system.duration}}" /></label>
        <label><span>Familia</span><input type="text" name="system.family" value="{{system.family}}" /></label>
        <label class="tm-check"><span>Saturante</span><input type="checkbox" name="system.saturating" {{checked system.saturating}} /></label>
        <label><span>Efecto</span><input type="text" name="system.effect" value="{{system.effect}}" /></label>
        <label><span>Conservación</span><input type="text" name="system.preservation" value="{{system.preservation}}" /></label>
      {{/if}}

      {{#if isRitual}}
        <label><span>Grado</span><input type="text" name="system.grade" value="{{system.grade}}" /></label>
        <label><span>Coste PD</span><input type="number" value="{{system.pdCost}}" disabled /></label>
        <label><span>DF</span><input type="number" name="system.difficulty" value="{{system.difficulty}}" min="0" /></label>
        <label><span>Tiempo</span><input type="text" name="system.time" value="{{system.time}}" /></label>
        <label><span>Participantes</span><input type="text" name="system.participants" value="{{system.participants}}" /></label>
        <label><span>Asistentes útiles</span><input type="number" name="system.usefulAssistants" value="{{system.usefulAssistants}}" min="0" /></label>
        <label><span>Componentes</span><input type="text" name="system.components" value="{{system.components}}" /></label>
        <label><span>Fuente</span><input type="text" name="system.source" value="{{system.source}}" /></label>
        <label><span>Alcance</span><input type="text" name="system.range" value="{{system.range}}" /></label>
        <label><span>Maná Director</span><input type="number" name="system.manaDirector" value="{{system.manaDirector}}" min="0" /></label>
        <label><span>Maná máx. por asistente</span><input type="number" name="system.manaAssistantMax" value="{{system.manaAssistantMax}}" min="0" /></label>
        <label><span>Caudal requerido</span><input type="number" name="system.flowRequired" value="{{system.flowRequired}}" min="0" /></label>
        <label><span>Efecto</span><input type="text" name="system.effect" value="{{system.effect}}" /></label>
        <label><span>Fallo</span><input type="text" name="system.failure" value="{{system.failure}}" /></label>
      {{/if}}

      {{#if isDevice}}
        <label><span>Categoría</span><input type="text" name="system.category" value="{{system.category}}" /></label>
        <label><span>Energía actual</span><input type="number" name="system.energy.value" value="{{system.energy.value}}" min="0" /></label>
        <label><span>Energía máxima</span><input type="number" name="system.energy.max" value="{{system.energy.max}}" min="0" /></label>
        <label><span>Fuente de Energía</span><select name="system.energySourceItemId">{{selectOptions deviceEnergySources selected=system.energySourceItemId}}</select></label>
        <label><span>Caudal</span><input type="number" name="system.flow" value="{{system.flow}}" min="0" /></label>
        <label><span>Activación</span><select name="system.activation"><option value="Acción" {{#if (eq system.activation "Acción")}}selected{{/if}}>Acción</option><option value="Reacción" {{#if (eq system.activation "Reacción")}}selected{{/if}}>Reacción</option></select></label>
        <label class="tm-check"><span>Defensa cinética equivalente (+2)</span><input type="checkbox" name="system.kineticDefense" {{checked system.kineticDefense}} /></label>
        <label><span>Estabilidad</span><input type="text" name="system.stability" value="{{system.stability}}" /></label>
        <label><span>Estado</span><select name="system.condition"><option value="operative" {{#if (eq system.condition "operative")}}selected{{/if}}>Operativo</option><option value="damaged" {{#if (eq system.condition "damaged")}}selected{{/if}}>Dañado</option><option value="disabled" {{#if (eq system.condition "disabled")}}selected{{/if}}>Deshabilitado</option></select></label>
        <label class="tm-check"><span>Admite Sobrecarga</span><input type="checkbox" name="system.overloadAllowed" {{checked system.overloadAllowed}} /></label>
        <label><span>Consumo</span><input type="number" name="system.consumption" value="{{system.consumption}}" min="0" /></label>
        <label><span>Efecto</span><input type="text" name="system.effect" value="{{system.effect}}" /></label>
      {{/if}}

      {{#if isDiscipline}}
        <label><span>Disciplina</span><select name="system.discipline">{{selectOptions config.disciplines selected=system.discipline}}</select></label>
      {{/if}}

      {{#if isEffect}}
        <label><span>Actor fuente UUID</span><input type="text" name="system.sourceActorUuid" value="{{system.sourceActorUuid}}" /></label>
        <label><span>Item fuente UUID</span><input type="text" name="system.sourceItemUuid" value="{{system.sourceItemUuid}}" /></label>
        <label><span>Duración</span><input type="text" name="system.duration" value="{{system.duration}}" /></label>
        <label><span>Expiración</span><select name="system.expiry">{{selectOptions config.effectExpiry selected=system.expiry}}</select></label>
        <label class="tm-check"><span>Activo</span><input type="checkbox" name="system.active" {{checked system.active}} /></label>
        <label><span>Clave de acumulación</span><input type="text" value="{{system.stackingKey}}" disabled /></label>
      {{/if}}

      {{#if isProject}}
        <div class="tm-wide tm-project-reference-browser">
          <div class="tm-section-heading"><h2>CRAFT-11 · referencia</h2><span>41 fichas canónicas</span></div>
          <div class="tm-section-buttons">
            <select data-project-reference>
              <option value="">Elegir referencia...</option>
              {{selectOptions projectReferenceOptions selected=project.source.profileRef}}
            </select>
            {{#if projectActions.canLoadReference}}<button type="button" data-action="project-reference-load">Cargar referencia</button>{{/if}}
          </div>
          {{#if projectReference}}
            <p><strong>{{projectReference.ref}} · {{projectReference.name}}</strong></p>
            <p>{{projectReference.category}} · Materiales {{projectReference.materialDisplay}} · Tiempo {{projectReference.timeDisplay}} · Valor {{projectReference.valueDisplay}}</p>
            <p>{{projectReference.skillLabel}} {{projectReference.rankLabel}}{{#if projectReference.specialization}} · {{projectReference.specialization}}{{/if}} · {{projectReference.installationLabel}}</p>
            <p>{{projectReference.summary}}</p>
            {{#each projectReference.notes as |note|}}<small>{{note}}</small>{{/each}}
          {{/if}}
        </div>

        <div class="tm-wide">
          <div class="tm-section-heading"><h2>Previsualización</h2><span>{{#if projectPreview.valid}}Lista para Preparar{{else}}Requiere atención{{/if}}</span></div>
          <p>Material previsto: <strong>{{projectMaterialDisplay}}</strong> · Asignado: <strong>{{projectAllocatedDisplay}}</strong> · Falta: <strong>{{projectMissingDisplay}}</strong></p>
          {{#if projectPreviewIssues.length}}
            <ul class="tm-warning">{{#each projectPreviewIssues as |issue|}}<li>{{issue.message}}</li>{{/each}}</ul>
          {{else}}
            <p>Sin incidencias estructurales o transaccionales.</p>
          {{/if}}
        </div>

        <label><span>Operación</span><select name="system.operation">{{selectOptions config.craftingProjectOperations selected=project.operation}}</select></label>
        <label><span>Estado</span><select name="system.state">{{selectOptions config.craftingProjectStates selected=project.state}}</select></label>
        <label><span>Receta / Item fuente UUID</span><input type="text" name="system.source.recipeUuid" value="{{project.source.recipeUuid}}" /></label>
        <label><span>Perfil / REF</span><input type="text" name="system.source.profileRef" value="{{project.source.profileRef}}" /></label>
        <label><span>Revisión fuente</span><input type="text" name="system.source.sourceRevision" value="{{project.source.sourceRevision}}" /></label>

        <label><span>Objetivo Item UUID</span><input type="text" name="system.target.itemUuid" value="{{project.target.itemUuid}}" /></label>
        <label><span>Tipo de resultado</span><input type="text" name="system.target.resultType" value="{{project.target.resultType}}" /></label>
        <label><span>Nombre de resultado</span><input type="text" name="system.target.resultName" value="{{project.target.resultName}}" /></label>

        <label><span>VR Común (c)</span><input type="number" min="0" step="1" name="system.economy.referenceValueCopper" value="{{project.economy.referenceValueCopper}}" /></label>
        <label><span>Estado de precio</span><select name="system.economy.priceStatus">{{selectOptions config.priceStatuses selected=project.economy.priceStatus}}</select></label>
        <label><span>Precio fijado (c)</span><input type="number" min="0" step="1" name="system.economy.fixedPriceCopper" value="{{project.economy.fixedPriceCopper}}" /></label>
        <label><span>Calidad</span><select name="system.economy.quality">{{selectOptions config.craftingQualities selected=project.economy.quality}}</select></label>
        <label><span>Grado material de trabajo</span><select name="system.economy.workMaterialGrade">{{selectOptions config.craftingMaterialGrades selected=project.economy.workMaterialGrade}}</select></label>
        <label><span>BRA / valor afectado (c)</span><input type="number" min="0" step="1" name="system.economy.affectedValueCopper" value="{{project.economy.affectedValueCopper}}" /></label>

        <label><span>Modo temporal</span><select name="system.time.mode">{{selectOptions config.craftingProjectTimeModes selected=project.time.mode}}</select></label>
        <label><span>Tiempo base (min)</span><input type="number" min="0" step="1" name="system.time.baseMinutes" value="{{project.time.baseMinutes}}" /></label>
        <label><span>TBA (min)</span><input type="number" min="0" step="1" name="system.time.adjustedBaseMinutes" value="{{project.time.adjustedBaseMinutes}}" /></label>
        <label><span>Tiempo requerido (min)</span><input type="number" min="0" step="1" name="system.time.requiredMinutes" value="{{project.time.requiredMinutes}}" /></label>
        <label><span>Trabajo completado (min)</span><input type="number" min="0" step="1" value="{{project.time.completedMinutes}}" disabled /></label>
        <label><span>Trabajo restante (min)</span><input type="number" value="{{projectRemainingMinutes}}" disabled /></label>

        <label><span>Habilidad principal</span><select name="system.professional.skill">{{selectOptions config.skillLabels selected=project.professional.skill}}</select></label>
        <label><span>Especialización</span><input type="text" name="system.professional.specialization" value="{{project.professional.specialization}}" /></label>
        <label><span>Rango base receta</span><select name="system.professional.baseRank">{{selectOptions config.rankOptionLabels selected=project.professional.baseRank}}</select></label>
        <label><span>Rango requerido</span><select name="system.professional.requiredRank">{{selectOptions config.rankOptionLabels selected=project.professional.requiredRank}}</select></label>
        <label><span>Instalación base</span><select name="system.professional.baseInstallation">{{selectOptions config.craftingInstallations selected=project.professional.baseInstallation}}</select></label>
        <label><span>Instalación requerida</span><select name="system.professional.requiredInstallation">{{selectOptions config.craftingInstallations selected=project.professional.requiredInstallation}}</select></label>
        <label><span>Instalación disponible</span><select name="system.professional.availableInstallation">{{selectOptions config.craftingInstallations selected=project.professional.availableInstallation}}</select></label>
        <label class="tm-check"><span>Procedimiento estable</span><input type="checkbox" name="system.professional.stableProcedure" {{checked project.professional.stableProcedure}} /></label>
        <label class="tm-check"><span>Materiales listos</span><input type="checkbox" name="system.professional.materialsReady" {{checked project.professional.materialsReady}} /></label>
        <label class="tm-check"><span>Herramienta/Kit esencial listo</span><input type="checkbox" name="system.professional.essentialToolReady" {{checked project.professional.essentialToolReady}} /></label>

        <label><span>Ayudantes de trabajo</span><input type="number" min="0" step="1" name="system.assistants.work" value="{{project.assistants.work}}" /></label>
        <label><span>Ayudantes técnicos</span><input type="number" min="0" step="1" name="system.assistants.technical" value="{{project.assistants.technical}}" /></label>
        <label class="tm-check"><span>Aceleración declarada</span><input type="checkbox" name="system.execution.accelerated" {{checked project.execution.accelerated}} /></label>
        <label><span>Resultado de Aceleración</span><select name="system.execution.accelerationOutcome">{{selectOptions config.craftingAccelerationOutcomes selected=project.execution.accelerationOutcome}}</select></label>
        <label><span>Etapa actual</span><input type="text" name="system.execution.stage" value="{{project.execution.stage}}" /></label>
        <label><span>Revisión transaccional</span><input type="number" value="{{project.execution.revision}}" disabled /></label>
        <label class="tm-check"><span>Recursos comprometidos</span><input type="checkbox" {{checked project.execution.committed}} disabled /></label>
        <label><span>Token de cierre</span><input type="text" value="{{project.execution.completionToken}}" disabled /></label>

        <label><span>Material estimado (c)</span><input type="number" value="{{project.ledger.estimatedMaterialsCopper}}" disabled /></label>
        <label><span>Material comprometido (c)</span><input type="number" value="{{project.ledger.committedMaterialsCopper}}" disabled /></label>
        <label><span>Material recuperado (c)</span><input type="number" value="{{project.ledger.recoveredMaterialsCopper}}" disabled /></label>
        <label><span>Registros internos</span><input type="text" value="ME {{projectCounts.specialMaterials}} · Componentes {{projectCounts.components}} · Consecuencias {{projectCounts.consequences}} · Ledger {{projectCounts.ledgerEntries}}" disabled /></label>

        <div class="tm-wide">
          <div class="tm-section-heading"><h2>Asignaciones de VI</h2><span>Se validan contra Lotes reales al comprometer</span></div>
          {{#each projectMaterialAllocations as |allocation|}}
            <div class="tm-skill-modifier-row">
              <span>{{allocation.sourceUuid}}</span>
              <span>{{allocation.amountDisplay}}</span>
              <span>{{allocation.compatibility}}</span>
              {{#if @root.projectActions.canLoadReference}}<button type="button" data-action="project-material-delete" data-index="{{allocation.index}}"><i class="fa-solid fa-trash"></i></button>{{/if}}
            </div>
          {{else}}
            <p class="tm-empty">Sin VI asignado.</p>
          {{/each}}
          {{#if projectActions.canLoadReference}}
            <div class="tm-skill-modifier-row">
              <select data-project-material-source>
                <option value="">Lote...</option>
                {{#each projectCraftingLots as |lot|}}<option value="{{lot.uuid}}">{{lot.name}} · libre {{lot.availableDisplay}} · {{lot.compatibility}}</option>{{/each}}
              </select>
              <input type="number" min="1" step="1" data-project-material-amount placeholder="VI en cobres" />
              <input type="text" data-project-material-compatibility placeholder="compatibilidad requerida" />
              <button type="button" data-action="project-material-add"><i class="fa-solid fa-plus"></i> Asignar</button>
            </div>
          {{/if}}
        </div>

        {{#if (eq project.operation "repair")}}
          <div class="tm-wide">
            <div class="tm-section-heading"><h2>Capas afectadas</h2><span>{{projectTargetName}}</span></div>
            {{#each projectRepairLayers as |layer|}}
              <div class="tm-skill-modifier-row">
                <span>{{layer.name}} · {{layer.part}}</span>
                <label class="tm-check"><span>Afectada</span><input type="checkbox" data-action="project-repair-layer" data-field="affected" data-material-id="{{layer.id}}" {{checked layer.affected}} /></label>
                <label class="tm-check"><span>Reemplazo ordinario</span><input type="checkbox" data-action="project-repair-layer" data-field="ordinary" data-material-id="{{layer.id}}" {{checked layer.ordinaryReplacement}} /></label>
              </div>
            {{/each}}
            {{#if projectRepairRunicAvailable}}<label class="tm-check"><span>Matriz rúnica afectada</span><input type="checkbox" data-action="project-repair-runic" {{checked project.repair.runicMatrixAffected}} /></label>{{/if}}
            {{#if projectRepairEnchantAvailable}}<label class="tm-check"><span>Matriz de Encantamiento afectada</span><input type="checkbox" data-action="project-repair-enchantment" {{checked project.repair.enchantmentMatrixAffected}} /></label>{{/if}}
          </div>
        {{/if}}

        {{#if projectRecovery}}
          <div class="tm-wide">
            <div class="tm-section-heading"><h2>Recuperación prevista</h2><span>Antes de desmantelar</span></div>
            <p>Ordinario: {{projectRecovery.ordinaryDisplay}} · Rúnico: {{projectRecovery.runicDisplay}} · Encantamiento: {{projectRecovery.enchantmentDisplay}}</p>
            {{#each projectRecovery.special as |row|}}<p>{{row.name}}: {{row.amountDisplay}}</p>{{/each}}
            {{#each projectRecovery.separable as |row|}}<p>Componente físico: {{row.name}} ×{{row.quantity}} · se recupera como objeto, no como VI.</p>{{/each}}
            <p><strong>Total VI previsto: {{projectRecovery.totalDisplay}}</strong> · trabajo {{projectRecovery.timeDisplay}}</p>
          </div>
        {{/if}}

        <div class="tm-wide">
          <div class="tm-section-heading"><h2>Flujo de Proyecto</h2><span>Las mutaciones pasan por autoridad compartida</span></div>
          <div class="tm-section-buttons">
            {{#if projectActions.canPrepare}}<button type="button" data-action="project-prepare">DJ · Preparar</button>{{/if}}
            {{#if projectActions.canReserve}}<button type="button" data-action="project-reserve">Comprometer recursos</button>{{/if}}
            {{#if projectActions.canRelease}}<button type="button" data-action="project-release">Liberar recursos</button>{{/if}}
            {{#if projectActions.canCancel}}<button type="button" data-action="project-cancel">Cancelar</button>{{/if}}
          </div>
          {{#if projectActions.canWork}}
            <div class="tm-section-buttons">
              <input type="number" min="1" step="1" data-project-work-minutes placeholder="Minutos de trabajo" />
              <button type="button" data-action="project-work">Registrar trabajo</button>
            </div>
          {{/if}}
          {{#if projectActions.canComplete}}<button type="button" data-action="project-complete">Completar Proyecto</button>{{/if}}
          {{#if projectActions.canResolveResearch}}
            <div class="tm-form-grid">
              <label><span>Resultado de etapa</span><select data-project-research-result><option value="success">Éxito</option><option value="failure">Fallo</option><option value="pifia">Pifia</option><option value="hazana">Hazaña</option></select></label>
              <label><span>Evidencia / método del intento</span><input type="text" data-project-attempt-key /></label>
              <label><span>Pregunta Correctiva si falla</span><input type="text" data-project-corrective /></label>
            </div>
            <button type="button" data-action="project-research-resolve">Resolver etapa CRAFT-10</button>
          {{/if}}
        </div>
      {{/if}}

      {{#if isPhysical}}
      <label><span>Cantidad</span><input type="number" name="system.quantity" value="{{system.quantity}}" min="0" /></label>

      <label><span>Peso</span><input type="number" name="system.weight" value="{{system.weight}}" min="0" step="0.1" /></label>
      <label><span>Estado de precio</span><select name="system.priceStatus">{{selectOptions config.priceStatuses selected=system.priceStatus}}</select></label>
      <label><span>Precio (cobres)</span><input type="number" name="system.priceCopper" value="{{system.priceCopper}}" min="0" step="1" /></label>
      <label><span>Unidad Comercial</span><input type="number" name="system.priceQuantity" value="{{system.priceQuantity}}" min="1" step="1" /></label>
      <label><span>Precio visible</span><input type="text" value="{{priceDisplay}}" disabled /></label>
      <label><span>Disponibilidad</span><select name="system.availability">{{selectOptions config.availability selected=system.availability}}</select></label>
      <label><span>Calidad</span><select name="system.quality">{{selectOptions config.qualities selected=system.quality}}</select></label>
      <label><span>Propiedades</span><input type="text" name="system.properties" value="{{system.properties}}" /></label>
      {{#if (or isWeapon isArmor isShield isEquipment)}}<label class="tm-check"><span>Equipado</span><input type="checkbox" name="system.equipped" {{checked system.equipped}} /></label>{{/if}}
      {{/if}}
    </div>
  </section>

  {{#unless isProject}}
  <section class="tm-panel tm-skill-requirements-editor">
    <div class="tm-section-heading">
      <h2>Costes de catálogo</h2>
      <span>El coste normal se separa de lo realmente pagado por esta instancia.</span>
    </div>
    <div class="tm-skill-modifier-list">
      {{#each costs as |cost|}}
        <div class="tm-skill-modifier-row">
          <select data-action="cost-field" data-index="{{cost.index}}" data-field="context">
            {{selectOptions @root.costContexts selected=cost.context}}
          </select>
          <select data-action="cost-field" data-index="{{cost.index}}" data-field="resource">
            {{selectOptions @root.config.paidResources selected=cost.resource}}
          </select>
          <input type="number" min="0" value="{{cost.amount}}" data-action="cost-field" data-index="{{cost.index}}" data-field="amount" />
          <button type="button" data-action="cost-delete" data-index="{{cost.index}}" title="Eliminar coste"><i class="fa-solid fa-trash"></i></button>
        </div>
      {{else}}
        <p class="tm-empty">Sin coste de catálogo.</p>
      {{/each}}
    </div>
    <button type="button" class="tm-skill-modifier-add" data-action="cost-add"><i class="fa-solid fa-plus"></i> Agregar coste</button>
  </section>

  <section class="tm-panel tm-skill-requirements-editor">
    <div class="tm-section-heading">
      <h2>Requisitos de Habilidad</h2>
      <span>El rango base requerido; los modificadores no cuentan como rango.</span>
    </div>
    <div class="tm-skill-modifier-list">
      {{#each skillRequirements as |requirement|}}
        <div class="tm-skill-modifier-row">
          <select data-action="skill-requirement-field" data-index="{{requirement.index}}" data-field="skill" title="Habilidad requerida">
            <option value="">Elegir Habilidad</option>
            {{selectOptions @root.config.skillLabels selected=requirement.skill}}
          </select>
          <select data-action="skill-requirement-field" data-index="{{requirement.index}}" data-field="minRank" title="Rango mínimo">
            {{selectOptions @root.config.rankOptionLabels selected=requirement.minRank}}
          </select>
          <select data-action="skill-requirement-field" data-index="{{requirement.index}}" data-field="basis" title="Base o efectivo">
            <option value="base" {{#if (eq requirement.basis "base")}}selected{{/if}}>Rango base</option>
            <option value="effective" {{#if (eq requirement.basis "effective")}}selected{{/if}}>Rango efectivo</option>
          </select>
          <button type="button" data-action="skill-requirement-delete" data-index="{{requirement.index}}" title="Eliminar requisito">
            <i class="fa-solid fa-trash"></i>
          </button>
        </div>
      {{else}}
        <p class="tm-empty">Sin requisitos mecánicos de Habilidad.</p>
      {{/each}}
    </div>
    <button type="button" class="tm-skill-modifier-add" data-action="skill-requirement-add">
      <i class="fa-solid fa-plus"></i> Agregar requisito de Habilidad
    </button>
  </section>

  <section class="tm-panel tm-skill-modifiers-editor">
    <div class="tm-section-heading">
      <h2>Modificadores de Habilidad</h2>
      <span>Bonificadores o penalizadores que este elemento aporta a Habilidades concretas.</span>
    </div>

    <p><small>Estos modificadores son Rule Elements declarativos. Equipo físico puede condicionarlos mediante predicates de equipamiento; los Effects controlan su propia activación.</small></p>

    <div class="tm-skill-modifier-list">
      {{#each skillModifiers as |modifier|}}
        <div class="tm-skill-modifier-row">
          <select data-action="skill-modifier-field" data-index="{{modifier.index}}" data-field="skill" title="Habilidad afectada">
            <option value="">Elegir Habilidad</option>
            {{selectOptions @root.config.skillLabels selected=modifier.skill}}
          </select>
          <input type="number" value="{{modifier.value}}" data-action="skill-modifier-field" data-index="{{modifier.index}}" data-field="value" title="Bonificador o penalizador" />
          <input type="text" value="{{modifier.label}}" data-action="skill-modifier-field" data-index="{{modifier.index}}" data-field="label" placeholder="Motivo / condición" title="Etiqueta opcional" />
          <button type="button" data-action="skill-modifier-delete" data-index="{{modifier.index}}" title="Eliminar modificador">
            <i class="fa-solid fa-trash"></i>
          </button>
        </div>
      {{else}}
        <p class="tm-empty">Este elemento no modifica Habilidades.</p>
      {{/each}}
    </div>

    <button type="button" class="tm-skill-modifier-add" data-action="skill-modifier-add">
      <i class="fa-solid fa-plus"></i> Agregar modificador
    </button>
  </section>

  {{/unless}}

  {{#if isProject}}
  <section class="tm-panel">
    <div class="tm-section-heading"><h2>Integridad del Proyecto</h2><span>CRAFT-13B</span></div>
    {{#if projectValidation.valid}}
      <p class="tm-empty">Estructura válida. La disponibilidad real de recursos se resolverá transaccionalmente en CRAFT-13C.</p>
    {{else}}
      {{#each projectValidation.issues as |issue|}}
        <p><strong>{{issue.code}}</strong> · {{issue.message}}</p>
      {{/each}}
    {{/if}}
  </section>
  {{/if}}

  <section class="tm-panel tm-editor-panel">
    <h2>Descripción</h2>
    {{editor enrichedDescription target="system.description" button=true editable=editable engine="prosemirror" collaborate=false}}
  </section>
</form>
