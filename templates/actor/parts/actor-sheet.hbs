<header class="tm-sheet-header">
  <img class="profile-img" src="{{actor.img}}" data-edit="img" title="{{actor.name}}" />
  <div class="tm-identity">
    <input class="tm-name" name="name" type="text" value="{{actor.name}}" placeholder="Nombre del personaje" />
    <div class="tm-identity-grid">
      <label>
        <span>Nivel</span>
        <input type="number" name="system.details.level" value="{{system.details.level}}" min="1" />
      </label>
      <label>
        <span>Linaje</span>
        <input type="text" name="system.details.ancestry" value="{{system.details.ancestry}}" />
      </label>
      <label>
        <span>Clase / Senda</span>
        <input type="text" name="system.details.class" value="{{system.details.class}}" />
      </label>
      <label>
        <span>Trasfondo</span>
        <input type="text" name="system.details.background" value="{{system.details.background}}" />
      </label>
    </div>
  </div>
  <div class="tm-level-seal">
    <span>NIVEL</span>
    <strong>{{system.details.level}}</strong>
  </div>
</header>

<section class="tm-resource-bar">
  <div class="tm-resource tm-health">
    <i class="fa-solid fa-heart"></i>
    <span>Vida</span>
    <input type="number" name="system.resources.health.value" value="{{system.resources.health.value}}" />
    <b>/</b>
    <input type="number" name="system.resources.health.max" value="{{system.resources.health.max}}" />
  </div>
  <div class="tm-resource tm-mana">
    <i class="fa-solid fa-star"></i>
    <span>Maná</span>
    <input type="number" name="system.resources.mana.value" value="{{system.resources.mana.value}}" />
    <b>/</b>
    <input type="number" name="system.resources.mana.max" value="{{system.resources.mana.max}}" />
  </div>
  <div class="tm-resource tm-stamina">
    <i class="fa-solid fa-bolt"></i>
    <span>Aguante</span>
    <input type="number" name="system.resources.stamina.value" value="{{system.resources.stamina.value}}" />
    <b>/</b>
    <input type="number" name="system.resources.stamina.max" value="{{system.resources.stamina.max}}" />
  </div>
</section>

<nav class="tm-tabs tabs" data-group="primary">
  <a class="item" data-tab="summary"><i class="fa-solid fa-shield-halved"></i> Resumen</a>
  <a class="item" data-tab="skills"><i class="fa-solid fa-list-check"></i> Habilidades</a>
  <a class="item" data-tab="combat"><i class="fa-solid fa-swords"></i> Combate</a>
  <a class="item" data-tab="inventory"><i class="fa-solid fa-backpack"></i> Inventario</a>
  <a class="item" data-tab="spells"><i class="fa-solid fa-sparkles"></i> Magia</a>
  <a class="item" data-tab="biography"><i class="fa-solid fa-feather"></i> Historia</a>
</nav>

<section class="tm-sheet-body">
  <div class="tab" data-group="primary" data-tab="summary">
    <div class="tm-summary-grid">
      <section class="tm-panel">
        <h2>Atributos</h2>
        <div class="tm-abilities">
          {{#each system.attributes as |ability key|}}
            <button type="button" class="tm-ability" data-action="roll-attribute" data-key="{{key}}" title="Tirar {{lookup ../config.abilities key}}">
              <span>{{lookup ../config.abilities key}}</span>
              <strong>{{ability.value}}</strong>
              <em>{{ability.signed}}</em>
            </button>
            <input class="tm-ability-score" type="number" name="system.attributes.{{key}}.value" value="{{ability.value}}" aria-label="Valor de {{lookup ../config.abilities key}}" />
          {{/each}}
        </div>
      </section>

      <section class="tm-panel">
        <h2>Defensas</h2>
        <div class="tm-defense-grid">
          <div><span>Armadura</span><strong>{{system.combat.defenses.armor}}</strong></div>
          <div><span>Fortaleza</span><strong>{{system.combat.defenses.fortitude}}</strong></div>
          <div><span>Reflejos</span><strong>{{system.combat.defenses.reflex}}</strong></div>
          <div><span>Voluntad</span><strong>{{system.combat.defenses.will}}</strong></div>
        </div>
        <div class="tm-quick-stats">
          <button type="button" data-action="roll-initiative">
            <i class="fa-solid fa-dice-d20"></i> Iniciativa {{numberFormat system.combat.initiative sign=true}}
          </button>
          <label><span>Velocidad</span><input type="number" name="system.combat.speed" value="{{system.combat.speed}}" step="0.5" /> m</label>
          <label><span>Competencia</span><input type="number" name="system.combat.proficiency" value="{{system.combat.proficiency}}" /></label>
          <label><span>Armadura adicional</span><input type="number" name="system.combat.armor" value="{{system.combat.armor}}" /></label>
        </div>
      </section>

      <section class="tm-panel tm-wide">
        <h2>Identidad</h2>
        <div class="tm-form-grid">
          <label><span>Cultura</span><input type="text" name="system.details.culture" value="{{system.details.culture}}" /></label>
          {{#unless isCharacter}}
            <label><span>Rol</span><input type="text" name="system.details.role" value="{{system.details.role}}" /></label>
            <label><span>Amenaza</span><input type="text" name="system.details.threat" value="{{system.details.threat}}" /></label>
          {{/unless}}
          <label><span>Idiomas</span><input type="text" name="system.traits.languages" value="{{system.traits.languages}}" /></label>
          <label><span>Sentidos</span><input type="text" name="system.traits.senses" value="{{system.traits.senses}}" /></label>
          <label><span>Tamaño</span><input type="text" name="system.traits.size" value="{{system.traits.size}}" /></label>
        </div>
      </section>
    </div>
  </div>

  <div class="tab" data-group="primary" data-tab="skills">
    <section class="tm-panel">
      <div class="tm-section-heading">
        <h2>Habilidades</h2>
        <span>Modificador + entrenamiento + bono</span>
      </div>
      <div class="tm-skill-list">
        <div class="tm-skill-row tm-list-header">
          <span>Habilidad</span><span>Atributo</span><span>Grado</span><span>Bono</span><span>Total</span>
        </div>
        {{#each system.skills as |skill key|}}
          <div class="tm-skill-row">
            <button type="button" data-action="roll-skill" data-key="{{key}}"><i class="fa-solid fa-dice-d20"></i> {{lookup ../config.skills key}}</button>
            <select name="system.skills.{{key}}.ability">
              {{selectOptions ../config.abilities selected=skill.ability}}
            </select>
            <select name="system.skills.{{key}}.rank">
              {{selectOptions ../config.ranks selected=skill.rank}}
            </select>
            <input type="number" name="system.skills.{{key}}.bonus" value="{{skill.bonus}}" />
            <strong>{{skill.signed}}</strong>
          </div>
        {{/each}}
      </div>
    </section>
  </div>

  <div class="tab" data-group="primary" data-tab="combat">
    {{> "systems/tierra-magica/templates/actor/parts/item-section.hbs" title="Armas" type="weapon" items=itemGroups.weapon}}
    {{> "systems/tierra-magica/templates/actor/parts/item-section.hbs" title="Armaduras" type="armor" items=itemGroups.armor}}
    {{> "systems/tierra-magica/templates/actor/parts/item-section.hbs" title="Talentos" type="talent" items=itemGroups.talent}}
  </div>

  <div class="tab" data-group="primary" data-tab="inventory">
    {{> "systems/tierra-magica/templates/actor/parts/item-section.hbs" title="Equipo" type="equipment" items=itemGroups.equipment}}
  </div>

  <div class="tab" data-group="primary" data-tab="spells">
    {{> "systems/tierra-magica/templates/actor/parts/item-section.hbs" title="Hechizos" type="spell" items=itemGroups.spell}}
  </div>

  <div class="tab" data-group="primary" data-tab="biography">
    <section class="tm-panel tm-editor-panel">
      <h2>Historia</h2>
      {{editor enrichedBiography target="system.biography" button=true editable=editable engine="prosemirror" collaborate=false}}
    </section>
    <section class="tm-panel tm-editor-panel">
      <h2>Notas</h2>
      {{editor enrichedNotes target="system.notes" button=true editable=editable engine="prosemirror" collaborate=false}}
    </section>
  </div>
</section>
