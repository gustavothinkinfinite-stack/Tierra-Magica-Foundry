<section class="tm-panel tm-item-section">
  <div class="tm-section-heading">
    <h2>{{title}}</h2>
    <div class="tm-section-buttons">
      {{#if (or (eq type "weapon") (eq type "armor") (eq type "shield") (eq type "spell") (eq type "technique") (eq type "formula") (eq type "ritual") (eq type "device"))}}
        <button type="button" class="tm-icon-button" data-action="content-browser" data-type="{{type}}"><i class="fa-solid fa-book"></i> Manual</button>
      {{/if}}
      {{#if @root.editable}}
        <button type="button" class="tm-icon-button" data-action="item-create" data-type="{{type}}"><i class="fa-solid fa-plus"></i> Agregar</button>
      {{/if}}
    </div>
  </div>
  <ol class="tm-item-list">
    {{#each items as |item|}}
      <li class="item tm-item-row" data-item-id="{{item.id}}">
        <img src="{{item.img}}" alt="" />
        <div class="tm-item-name">
          <strong>{{item.name}}</strong>
          {{#if (eq item.type "weapon")}}<small>Daño {{item.system.damage}} · Pen {{item.system.penetration}} · {{item.system.properties}}</small>{{/if}}
          {{#if (eq item.type "armor")}}<small>Protección {{item.system.protection}} · FUE {{item.system.strengthMin}}</small>{{/if}}
          {{#if (eq item.type "shield")}}<small>Defensa +{{item.system.passiveDefense}} · Bloqueo +{{item.system.block}}</small>{{/if}}
          {{#if (eq item.type "spell")}}<small>{{lookup @root.config.disciplines item.system.discipline}} · {{item.system.manaCost}} Maná</small>{{/if}}
          {{#if (eq item.type "technique")}}<small>{{lookup @root.config.techniqueGrades item.system.grade}} · {{item.system.pdCost}} PD</small>{{/if}}
          {{#if (eq item.type "trait")}}<small>{{lookup @root.config.traitCategories item.system.category}} · Coste {{item.system.traitCost}}</small>{{/if}}
          {{#if (eq item.type "specialization")}}<small>{{item.system.effect}}</small>{{/if}}
          {{#if (eq item.type "equipment")}}<small>Cantidad {{item.system.quantity}} · {{item.system.availability}}</small>{{/if}}
          {{#if (eq item.type "formula")}}<small>Dosis {{item.system.quantity}}{{#if item.system.saturating}} · Saturante: {{item.system.family}}{{/if}}</small>{{/if}}
          {{#if (eq item.type "ritual")}}<small>DF {{item.system.difficulty}} · Director {{item.system.manaDirector}} Maná · {{item.system.time}}</small>{{/if}}
          {{#if (eq item.type "device")}}<small>Energía {{item.system.energy.value}}/{{item.system.energy.max}} · Caudal {{item.system.flow}} · {{item.system.condition}}</small>{{/if}}
        </div>
        <div class="tm-item-actions">
          {{#if (eq item.type "weapon")}}
            <button type="button" data-action="item-attack">Ataque</button>
            <button type="button" data-action="item-damage">Daño</button>
          {{/if}}
          {{#if (eq item.type "spell")}}<button type="button" data-action="item-spell">Lanzar</button>{{/if}}
          {{#if (eq item.type "formula")}}<button type="button" data-action="item-formula">Usar</button>{{/if}}
          {{#if (eq item.type "ritual")}}<button type="button" data-action="item-ritual">Realizar</button>{{/if}}
          {{#if (eq item.type "device")}}<button type="button" data-action="item-device">Activar</button><button type="button" data-action="item-device-overload">Sobrecargar</button>{{/if}}
          {{#if (or (eq item.type "weapon") (eq item.type "armor") (eq item.type "shield"))}}
            <button type="button" class="tm-icon-button {{#if item.system.equipped}}active{{/if}}" data-action="item-toggle" title="Equipar"><i class="fa-solid fa-hand"></i></button>
          {{/if}}
          <button type="button" class="tm-icon-button" data-action="item-edit"><i class="fa-solid fa-pen-to-square"></i></button>
          {{#if @root.editable}}<button type="button" class="tm-icon-button tm-danger" data-action="item-delete"><i class="fa-solid fa-trash"></i></button>{{/if}}
        </div>
      </li>
    {{else}}
      <li class="tm-empty">No hay elementos en esta sección.</li>
    {{/each}}
  </ol>
</section>
