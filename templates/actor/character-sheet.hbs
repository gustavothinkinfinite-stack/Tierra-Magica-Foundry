<form class="{{cssClass}} tm-actor-sheet tm-character-sheet-v03" autocomplete="off">
<div class="tm-v03-shell">

  <header class="tm-v03-header tm-v09-header">
    <h1 class="tm-v09-visually-hidden">TIERRA MÁGICA</h1>
    <img class="tm-v09-title-art tm-v091-title-art" src="systems/tierra-magica/assets/ui/tierra-magica-banner-final.jpg" alt="Tierra Mágica — Historias que dejan huella" />
  </header>

  <section class="tm-v03-identity">
    <label class="tm-v03-name">
      <span>Nombre</span>
      <input name="name" type="text" value="{{actor.name}}" placeholder="Nombre del personaje" />
    </label>
    <label class="tm-v03-concept">
      <span>Concepto</span>
      <input type="text" name="system.details.concept" value="{{system.details.concept}}" />
    </label>
    <label>
      <span>Origen</span>
      <input type="text" name="system.details.origin" value="{{system.details.origin}}" />
    </label>
    <label>
      <span>Raza / Ancestría</span>
      <input type="text" name="system.details.ancestry" value="{{system.details.ancestry}}" />
    </label>
    <label class="tm-v03-background-field">
      <span>Trasfondo</span>
      <input type="text" name="system.details.background" value="{{system.details.background}}" />
    </label>
  </section>

  <nav class="tm-tabs tm-v03-page-tabs tabs" data-group="primary" aria-label="Páginas de la ficha">
    <a class="item" data-tab="summary"><i class="fa-solid fa-user"></i><span>Ficha</span></a>
    <a class="item" data-tab="skills"><i class="fa-solid fa-list-check"></i><span>Habilidades</span></a>
    <a class="item" data-tab="combat"><i class="fa-solid fa-swords"></i><span>Combate</span></a>
    <a class="item" data-tab="magic"><i class="fa-solid fa-wand-sparkles"></i><span>Magia</span></a>
    <a class="item" data-tab="development"><i class="fa-solid fa-diagram-project"></i><span>Desarrollo</span></a>
    <a class="item" data-tab="inventory"><i class="fa-solid fa-backpack"></i><span>Equipo</span></a>
    <a class="item" data-tab="biography"><i class="fa-solid fa-feather"></i><span>Historia</span></a>
  </nav>

  <section class="tm-sheet-body tm-v03-body">
    <div class="tab" data-group="primary" data-tab="summary">
      <div class="tm-v03-dashboard">

        <aside class="tm-v03-left-rail">
          <section class="tm-v03-panel tm-v03-skills-panel tm-v03-skills-quick">
            <header class="tm-v03-panel-heading">
              <h2>Habilidades</h2>
            </header>

            <div class="tm-v03-quick-skill-list">
              {{#each skillGroups as |group|}}
                {{#each group.skills as |skill|}}
                  <button type="button" class="tm-v03-quick-skill" data-action="roll-skill" data-key="{{skill.key}}" title="Tirar {{skill.label}}">
                    <span>{{skill.label}}</span>
                    <b>{{skill.bonusDisplay}}</b>
                  </button>
                {{/each}}
              {{/each}}
            </div>
          </section>
        </aside>

        <main class="tm-v03-character-stage">
          <div class="tm-v03-stage-stars" aria-hidden="true"></div>
          <div class="tm-v03-stage-runes" aria-hidden="true"></div>
          <div class="tm-v03-stage-ring" aria-hidden="true"></div>

          <button type="button" class="tm-v03-attribute tm-v03-int" data-action="roll-attribute" data-key="int" title="INT · clic para tirar; Mayús para configurar"><span>INT</span><b>{{system.attributes.int.value}}</b><i class="fa-solid fa-book-open" aria-hidden="true"></i></button>
          <button type="button" class="tm-v03-attribute tm-v03-per" data-action="roll-attribute" data-key="per" title="PER · clic para tirar; Mayús para configurar"><span>PER</span><b>{{system.attributes.per.value}}</b><i class="fa-solid fa-eye" aria-hidden="true"></i></button>
          <button type="button" class="tm-v03-attribute tm-v03-vol" data-action="roll-attribute" data-key="vol" title="VOL · clic para tirar; Mayús para configurar"><span>VOL</span><b>{{system.attributes.vol.value}}</b><i class="fa-solid fa-fire-flame-curved" aria-hidden="true"></i></button>
          <button type="button" class="tm-v03-attribute tm-v03-agi" data-action="roll-attribute" data-key="agi" title="AGI · clic para tirar; Mayús para configurar"><span>AGI</span><b>{{system.attributes.agi.value}}</b><i class="fa-solid fa-person-running" aria-hidden="true"></i></button>
          <button type="button" class="tm-v03-attribute tm-v03-pre" data-action="roll-attribute" data-key="pre" title="PRE · clic para tirar; Mayús para configurar"><span>PRE</span><b>{{system.attributes.pre.value}}</b><i class="fa-solid fa-star" aria-hidden="true"></i></button>
          <button type="button" class="tm-v03-attribute tm-v03-fue" data-action="roll-attribute" data-key="fue" title="FUE · clic para tirar; Mayús para configurar"><span>FUE</span><b>{{system.attributes.fue.value}}</b><i class="fa-solid fa-hand-fist" aria-hidden="true"></i></button>
          <button type="button" class="tm-v03-attribute tm-v03-vig" data-action="roll-attribute" data-key="vig" title="VIG · clic para tirar; Mayús para configurar"><span>VIG</span><b>{{system.attributes.vig.value}}</b><i class="fa-solid fa-shield" aria-hidden="true"></i></button>

          <div class="tm-v03-portrait-frame">
            <img class="profile-img tm-v03-portrait" src="{{actor.img}}" data-edit="img" title="Cambiar retrato de {{actor.name}}" />
            <span class="tm-v03-portrait-caption">{{actor.name}}</span>
          </div>

          <section class="tm-v03-resources">
            <article class="tm-v03-resource tm-v03-health" style="--tm-fill: {{healthPercent}}%;">
              <div class="tm-v03-resource-label"><i class="fa-solid fa-heart"></i><span>Vida</span></div>
              <div class="tm-v03-resource-value">
                <button type="button" data-action="resource-change" data-resource="health" data-amount="-1"><i class="fa-solid fa-minus"></i></button>
                <input type="number" name="system.resources.health.value" value="{{system.resources.health.value}}" />
                <b>/ {{system.derived.healthMax}}</b>
                <button type="button" data-action="resource-change" data-resource="health" data-amount="1"><i class="fa-solid fa-plus"></i></button>
              </div>
              <div class="tm-v03-resource-track"><i></i></div>
            </article>

            <article class="tm-v03-resource tm-v03-mana" style="--tm-fill: {{manaPercent}}%;">
              <div class="tm-v03-resource-label"><i class="fa-solid fa-sparkles"></i><span>Maná</span></div>
              <div class="tm-v03-resource-value">
                <button type="button" data-action="resource-change" data-resource="mana" data-amount="-1"><i class="fa-solid fa-minus"></i></button>
                <input type="number" name="system.resources.mana.value" value="{{system.resources.mana.value}}" />
                <b>/ {{system.derived.manaMax}}</b>
                <button type="button" data-action="resource-change" data-resource="mana" data-amount="1"><i class="fa-solid fa-plus"></i></button>
              </div>
              <div class="tm-v03-resource-track"><i></i></div>
            </article>

            <article class="tm-v03-resource tm-v03-development">
              <div class="tm-v03-resource-label"><i class="fa-solid fa-compass-drafting"></i><span>Desarrollo</span></div>
              <div class="tm-v03-pd-value"><strong>{{development.pdAvailable}}</strong><small>disponibles</small><b>{{development.pdTotal}}</b><small>totales</small></div>
            </article>
          </section>

          <section class="tm-v03-turn">
            <div class="tm-v03-turn-heading">
              <span>Turno</span>
              <button type="button" data-action="reset-turn" title="Restablecer Movimiento, Acción y Reacción"><i class="fa-solid fa-rotate-right"></i></button>
            </div>
            <div class="tm-v03-turn-actions">
              <button type="button" class="{{#unless turn.movement}}spent{{/unless}}" data-action="toggle-turn" data-key="movement">
                <i class="fa-solid fa-person-running"></i>
                <span>Movimiento</span>
                <small>{{#if turn.movement}}Disponible{{else}}Gastado{{/if}}</small>
              </button>
              <button type="button" class="{{#unless turn.action}}spent{{/unless}}" data-action="toggle-turn" data-key="action">
                <i class="fa-solid fa-bolt"></i>
                <span>Acción</span>
                <small>{{#if turn.action}}Disponible{{else}}Gastada{{/if}}</small>
              </button>
              <button type="button" class="{{#unless turn.reaction}}spent{{/unless}}" data-action="toggle-turn" data-key="reaction">
                <i class="fa-solid fa-shield-halved"></i>
                <span>Reacción</span>
                <small>{{#if turn.reaction}}Disponible{{else}}Gastada{{/if}}</small>
              </button>
            </div>
          </section>

          <div class="tm-v09-motto" aria-hidden="true">
            <span>✦</span><b>EXPLORA</b><i>•</i><b>CREA</b><i>•</i><b>ENFRENTA</b><i>•</i><b>TRASCIENDE</b><span>✦</span>
          </div>
        </main>

        <aside class="tm-v03-right-rail">
          <section class="tm-v03-panel tm-v03-defenses">
            <header class="tm-v03-panel-heading">
              <h2>Defensas</h2>
            </header>
            <div class="tm-v03-defense-grid">
              <div class="tm-v09-defense tm-v09-defense-general"><i class="fa-solid fa-shield-halved"></i><span>Defensa</span><b>{{system.derived.defense}}</b></div>
              <div class="tm-v09-defense tm-v09-defense-maneuver"><i class="fa-solid fa-swords"></i><span>Maniobra</span><b>{{system.derived.maneuverDefense}}</b></div>
              <div class="tm-v09-defense tm-v09-defense-mental"><i class="fa-solid fa-brain"></i><span>Mental</span><b>{{system.derived.mentalDefense}}</b></div>
              <div class="tm-v09-defense tm-v09-defense-body"><i class="fa-solid fa-person"></i><span>Corporal</span><b>{{system.derived.bodyDefense}}</b></div>
            </div>
            <div class="tm-v03-derived-list">
              <button type="button" data-action="roll-initiative"><span>Iniciativa</span><b>+{{system.derived.initiative}}</b><i class="fa-solid fa-dice"></i></button>
              <div><span>Protección</span><b>{{system.derived.protection}}</b></div>
              <div><span>Daño Grave</span><b>{{system.derived.severeThreshold}}</b></div>
              <div><span>Movimiento</span><b>{{system.derived.movement}}</b></div>
            </div>
          </section>

          <section class="tm-v03-panel tm-v03-state">
            <header class="tm-v03-panel-heading"><h2>Estado</h2></header>
            <div class="tm-v03-state-grid">
              <label><span>Trauma</span><select name="system.status.trauma">{{selectOptions config.trauma selected=system.status.trauma}}</select></label>
              <label><span>Fatiga</span><select name="system.status.fatigue">{{selectOptions config.fatigue selected=system.status.fatigue}}</select></label>
              <label><span>Sangrado</span><input type="number" name="system.status.bleeding" value="{{system.status.bleeding}}" min="0" max="2" /></label>
              <label class="tm-v03-condition"><span>Condiciones</span><input type="text" name="system.status.conditions" value="{{system.status.conditions}}" placeholder="Derribado, Agarrado..." /></label>
            </div>
          </section>

          <section class="tm-v03-panel tm-v03-list-panel">
            <header class="tm-v03-panel-heading"><h2>Rasgos</h2></header>
            <ol class="tm-v03-mini-list">
              {{#each itemGroups.trait as |item|}}
                <li class="item" data-item-id="{{item.id}}"><button type="button" data-action="item-edit"><span>{{item.name}}</span><small>{{lookup @root.config.traitCategories item.system.category}}</small></button></li>
              {{else}}<li class="tm-v03-empty">Sin rasgos registrados.</li>{{/each}}
            </ol>
          </section>

          <section class="tm-v03-panel tm-v03-list-panel">
            <header class="tm-v03-panel-heading"><h2>Especializaciones</h2></header>
            <ol class="tm-v03-mini-list">
              {{#each itemGroups.specialization as |item|}}
                <li class="item" data-item-id="{{item.id}}"><button type="button" data-action="item-edit"><span>{{item.name}}</span><small>{{item.system.skill}}</small></button></li>
              {{else}}<li class="tm-v03-empty">Sin especializaciones.</li>{{/each}}
            </ol>
          </section>

          <section class="tm-v03-panel tm-v03-list-panel">
            <header class="tm-v03-panel-heading"><h2>Técnicas</h2></header>
            <ol class="tm-v03-mini-list">
              {{#each itemGroups.technique as |item|}}
                <li class="item" data-item-id="{{item.id}}"><button type="button" data-action="item-edit"><span>{{item.name}}</span><small>{{lookup @root.config.techniqueGrades item.system.grade}} · {{item.system.pdCost}} PD</small></button></li>
              {{else}}<li class="tm-v03-empty">Sin técnicas registradas.</li>{{/each}}
            </ol>
          </section>

          <button type="button" class="tm-v03-familiar" data-action="open-familiar">
            {{#if familiar}}
              <img src="{{familiar.img}}" alt="" />
              <span><b>{{familiar.name}}</b><small>Abrir Familiar</small></span>
            {{else}}
              <i class="fa-solid fa-paw"></i>
              <span><b>Familiar</b><small>Crear vínculo</small></span>
            {{/if}}
          </button>

          <div class="tm-v03-rest-actions">
            <button type="button" data-action="rest" data-kind="breather"><i class="fa-solid fa-mug-hot"></i> Respiro (~10 min)</button>
            <button type="button" data-action="rest" data-kind="rest"><i class="fa-solid fa-campground"></i> Descanso (~1 h)</button>
            <button type="button" data-action="rest" data-kind="full"><i class="fa-solid fa-bed"></i> Descanso completo (~8 h)</button>
          </div>
        </aside>
      </div>
    </div>

    <div class="tab" data-group="primary" data-tab="skills">
      <section class="tm-v03-page-hero tm-v03-skills-hero">
        <i class="fa-solid fa-list-check"></i>
        <div>
          <small>Página de habilidades</small>
          <h2>Habilidades</h2>
          <p>Rangos, modificadores automáticos, temporales y fuentes que componen cada valor final.</p>
        </div>
        <button type="button" class="tm-v04-clear-temporaries" data-action="clear-skill-temporaries" title="Poner todos los modificadores temporales en 0">
          <i class="fa-solid fa-eraser"></i>
          <span>Limpiar temporales</span>
        </button>
      </section>

      <section class="tm-v03-skills-page">
        {{#each skillGroups as |group|}}
          <section class="tm-v03-panel tm-v03-skill-category">
            <header class="tm-v03-skill-category-heading">
              <i class="fa-solid {{group.icon}}"></i>
              <h3>{{group.label}}</h3>
            </header>

            <div class="tm-v03-skill-category-list tm-v04-skill-category-list">
              {{#each group.skills as |skill|}}
                <article class="tm-v04-skill-detail">
                  <div class="tm-v04-skill-main">
                    <button type="button" class="tm-v04-skill-name" data-action="roll-skill" data-key="{{skill.key}}" title="Tirar {{skill.label}}">
                      <span>{{skill.label}}</span>
                      <i class="fa-solid fa-dice"></i>
                    </button>

                    <select data-action="set-skill-rank" data-key="{{skill.key}}" title="Rango de {{skill.label}}">
                      {{selectOptions @root.config.rankLabels selected=skill.rank}}
                    </select>

                    <div class="tm-v04-skill-total" title="Modificador final de la Habilidad">
                      <small>Total</small>
                      <b>{{skill.bonusDisplay}}</b>
                    </div>

                    <button type="button" class="tm-v04-roll-button" data-action="roll-skill" data-key="{{skill.key}}" title="Tirar {{skill.label}}">
                      <i class="fa-solid fa-dice-d10"></i>
                    </button>
                  </div>

                  <div class="tm-v04-skill-breakdown">
                    {{#each skill.modifierSummary as |modifier|}}
                      <span class="tm-v04-modifier-chip tm-v04-modifier-{{modifier.key}}">
                        <small>{{modifier.label}}</small>
                        <b>{{modifier.display}}</b>
                      </span>
                    {{/each}}

                    <label class="tm-v04-manual-modifier">
                      <small>Temporal</small>
                      <input type="number" value="{{skill.temporary}}" data-action="set-skill-temporary" data-key="{{skill.key}}" title="Modificador temporal" />
                    </label>

                    <label class="tm-v04-manual-modifier">
                      <small>Otros</small>
                      <input type="number" value="{{skill.other}}" data-action="set-skill-other" data-key="{{skill.key}}" title="Otro modificador manual" />
                    </label>
                  </div>

                  {{#if skill.sources.length}}
                    <div class="tm-v04-skill-sources">
                      <span class="tm-v04-sources-title"><i class="fa-solid fa-link"></i> Fuentes activas</span>
                      <div class="tm-v04-source-list">
                        {{#each skill.sources as |source|}}
                          <button type="button" class="tm-v04-source" data-action="skill-source-open" data-item-id="{{source.itemId}}" title="Abrir {{source.name}}">
                            <span>
                              <b>{{source.name}}</b>
                              <small>{{source.categoryLabel}}{{#if source.label}} · {{source.label}}{{/if}}</small>
                            </span>
                            <strong>{{source.display}}</strong>
                          </button>
                        {{/each}}
                      </div>
                    </div>
                  {{/if}}

                  {{#if skill.linkedSpecializations.length}}
                    <div class="tm-v04-linked-specializations">
                      <span>Especializaciones:</span>
                      {{#each skill.linkedSpecializations as |specialization|}}
                        <button type="button" data-action="skill-source-open" data-item-id="{{specialization.id}}">{{specialization.name}}</button>
                      {{/each}}
                    </div>
                  {{/if}}
                </article>
              {{/each}}
            </div>
          </section>
        {{/each}}
      </section>

      <section class="tm-v03-skills-support-grid">
        <section class="tm-v03-panel tm-v03-page-panel">
          <div class="tm-section-heading"><h2>Especializaciones</h2><span>Relacionadas con tus Habilidades.</span></div>
          <ol class="tm-v03-mini-list">
            {{#each itemGroups.specialization as |item|}}
              <li class="item" data-item-id="{{item.id}}">
                <button type="button" data-action="item-edit">
                  <span>{{item.name}}</span>
                  <small>{{item.system.skill}}</small>
                </button>
              </li>
            {{else}}
              <li class="tm-v03-empty">Sin especializaciones registradas.</li>
            {{/each}}
          </ol>
        </section>

        <section class="tm-v03-panel tm-v03-page-panel">
          <div class="tm-section-heading"><h2>Técnicas</h2><span>Capacidades ligadas a tu entrenamiento.</span></div>
          <ol class="tm-v03-mini-list">
            {{#each itemGroups.technique as |item|}}
              <li class="item" data-item-id="{{item.id}}">
                <button type="button" data-action="item-edit">
                  <span>{{item.name}}</span>
                  <small>{{lookup @root.config.techniqueGrades item.system.grade}} · {{item.system.pdCost}} PD</small>
                </button>
              </li>
            {{else}}
              <li class="tm-v03-empty">Sin técnicas registradas.</li>
            {{/each}}
          </ol>
        </section>
      </section>
    </div>

    <div class="tab" data-group="primary" data-tab="combat">
      <section class="tm-v03-page-hero">
        <i class="fa-solid fa-swords"></i>
        <div><small>Página de combate</small><h2>Combate</h2><p>Armas preparadas, protección, escudos y técnicas de combate.</p></div>
      </section>
      <section class="tm-panel tm-v03-page-panel">
        <div class="tm-section-heading"><h2>Configuración defensiva</h2><span>Ajustes y entrenamiento marcial.</span></div>
        <div class="tm-form-grid">
          <label><span>Rango marcial relevante</span><select name="system.combat.defensiveRank">{{selectOptions config.rankLabels selected=system.combat.defensiveRank}}</select></label>
          <label><span>Mod. Defensa</span><input type="number" name="system.combat.defenseBonus" value="{{system.combat.defenseBonus}}" /></label>
          <label><span>Mod. Protección</span><input type="number" name="system.combat.protectionBonus" value="{{system.combat.protectionBonus}}" /></label>
          <label><span>Mod. Movimiento</span><input type="number" name="system.combat.movementBonus" value="{{system.combat.movementBonus}}" /></label>
        </div>
      </section>
      {{> "systems/tierra-magica/templates/actor/parts/item-section.hbs" title="Armas preparadas" type="weapon" items=itemGroups.weapon}}
      {{> "systems/tierra-magica/templates/actor/parts/item-section.hbs" title="Armaduras" type="armor" items=itemGroups.armor}}
      {{> "systems/tierra-magica/templates/actor/parts/item-section.hbs" title="Escudos" type="shield" items=itemGroups.shield}}
      {{> "systems/tierra-magica/templates/actor/parts/item-section.hbs" title="Técnicas" type="technique" items=itemGroups.technique}}
    </div>

    <div class="tab" data-group="primary" data-tab="magic">
      <section class="tm-v03-page-hero tm-v03-magic-hero">
        <i class="fa-solid fa-wand-sparkles"></i>
        <div><small>Página de magia</small><h2>Magia</h2><p>Fuente + Disciplina + Método + Conocimiento → Hechizo.</p></div>
        <div class="tm-v03-hero-resource"><span>Maná</span><b>{{system.resources.mana.value}}</b><small>/ {{system.derived.manaMax}}</small></div>
      </section>

      <section class="tm-panel tm-v03-page-panel">
        <div class="tm-v03-discipline-grid">
          <div><i class="fa-solid fa-fire"></i><span>Evocación</span></div>
          <div><i class="fa-solid fa-shuffle"></i><span>Alteración</span></div>
          <div><i class="fa-solid fa-hand-holding-medical"></i><span>Restauración</span></div>
          <div><i class="fa-solid fa-eye"></i><span>Percepción</span></div>
          <div><i class="fa-solid fa-comments"></i><span>Influencia</span></div>
          <div><i class="fa-solid fa-door-open"></i><span>Conjuración</span></div>
        </div>
        <div class="tm-v03-magic-skill-strip">
          <span>Canalización <b>+{{system.skills.channeling.bonus}}</b></span>
          <span>Ritualismo <b>+{{system.skills.ritualism.bonus}}</b></span>
          <span>Arcana <b>+{{system.skills.arcana.bonus}}</b></span>
        </div>
      </section>

      <section class="tm-panel tm-v03-page-panel">
        <div class="tm-section-heading"><h2>Sostenimiento</h2><span>Un efecto demandante; Doble Sostenimiento permite dos.</span></div>
        <ol class="tm-item-list">
          {{#each sustainedSpells as |spell|}}
            <li class="tm-item-row"><div class="tm-item-name"><strong>{{spell.name}}</strong></div><button type="button" data-action="stop-sustained" data-item-id="{{spell.id}}">Abandonar</button></li>
          {{else}}<li class="tm-empty">Sin efectos sostenidos demandantes.</li>{{/each}}
        </ol>
      </section>
      {{> "systems/tierra-magica/templates/actor/parts/item-section.hbs" title="Grimorio" type="spell" items=itemGroups.spell}}
      {{> "systems/tierra-magica/templates/actor/parts/item-section.hbs" title="Preparaciones alquímicas" type="formula" items=itemGroups.formula}}
    </div>

    <div class="tab" data-group="primary" data-tab="development">
      <section class="tm-v03-page-hero">
        <i class="fa-solid fa-diagram-project"></i>
        <div><small>Página de desarrollo</small><h2>Desarrollo</h2><p>Atributos, nivel, PD y crecimiento del personaje.</p></div>
      </section>

      <section class="tm-v03-development-summary">
        <label>
          <span>Nivel</span>
          <input type="number" value="{{system.details.level}}" min="1" max="20" data-action="set-numeric-field" data-field="system.details.level" />
        </label>
        <div><span>PD totales</span><b>{{development.pdTotal}}</b></div>
        <label>
          <span>PD gastados</span>
          <input type="number" value="{{system.details.pdSpent}}" min="0" data-action="set-numeric-field" data-field="system.details.pdSpent" />
        </label>
        <div class="tm-v03-pd-available"><span>PD disponibles</span><b>{{development.pdAvailable}}</b></div>
      </section>

      <section class="tm-panel tm-v03-page-panel">
        <div class="tm-section-heading"><h2>Atributos</h2><span>Edición de valores base.</span></div>
        <div class="tm-v03-attribute-editor">
          {{#each system.attributes as |attribute key|}}
            <label><span>{{lookup ../config.attributes key}}</span><input type="number" name="system.attributes.{{key}}.value" value="{{attribute.value}}" min="0" max="8" /></label>
          {{/each}}
        </div>
      </section>

      <section class="tm-panel tm-v03-page-panel">
        <div class="tm-section-heading"><h2>Identidad mecánica</h2><span>Información complementaria.</span></div>
        <div class="tm-form-grid">
          <label><span>Idiomas</span><input type="text" name="system.traits.languages" value="{{system.traits.languages}}" /></label>
          <label><span>Sentidos</span><input type="text" name="system.traits.senses" value="{{system.traits.senses}}" /></label>
          <label><span>Escala</span><select name="system.traits.size">{{selectOptions config.sizes selected=system.traits.size}}</select></label>
        </div>
      </section>

      {{> "systems/tierra-magica/templates/actor/parts/item-section.hbs" title="Especializaciones" type="specialization" items=itemGroups.specialization}}
      {{> "systems/tierra-magica/templates/actor/parts/item-section.hbs" title="Rasgos" type="trait" items=itemGroups.trait}}
    </div>

    <div class="tab" data-group="primary" data-tab="inventory">
      <section class="tm-v03-page-hero">
        <i class="fa-solid fa-backpack"></i>
        <div><small>Página de equipo</small><h2>Equipo</h2><p>Inventario, recursos y objetos transportados.</p></div>
      </section>
      <section class="tm-panel tm-currency tm-v03-page-panel">
        <div class="tm-section-heading"><h2>Moneda</h2><span>Recursos disponibles.</span></div>
        <label>Oro <input type="number" name="system.currency.gold" value="{{system.currency.gold}}" /></label>
        <label>Plata <input type="number" name="system.currency.silver" value="{{system.currency.silver}}" /></label>
        <label>Cobre <input type="number" name="system.currency.copper" value="{{system.currency.copper}}" /></label>
      </section>
      {{> "systems/tierra-magica/templates/actor/parts/item-section.hbs" title="Equipo e inventario" type="equipment" items=itemGroups.equipment}}
    </div>

    <div class="tab" data-group="primary" data-tab="biography">
      <section class="tm-v03-page-hero">
        <i class="fa-solid fa-feather"></i>
        <div><small>Página de historia</small><h2>Historia</h2><p>Biografía, notas y detalles del personaje.</p></div>
      </section>
      <section class="tm-panel tm-editor-panel tm-v03-page-panel"><h2>Historia</h2>{{editor enrichedBiography target="system.biography" button=true editable=editable engine="prosemirror" collaborate=false}}</section>
      <section class="tm-panel tm-editor-panel tm-v03-page-panel"><h2>Notas</h2>{{editor enrichedNotes target="system.notes" button=true editable=editable engine="prosemirror" collaborate=false}}</section>
    </div>
  </section>
</div>
</form>
