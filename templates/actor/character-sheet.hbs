<form class="{{cssClass}} tm-actor-sheet tm-character-sheet-v03" autocomplete="off">
<div class="tm-v03-shell">

  <header class="tm-v03-header tm-v09-header tm-v10-header">
    <h1 class="tm-v09-visually-hidden">TIERRA MÁGICA</h1>
    <img class="tm-v09-title-art tm-v091-title-art" src="systems/tierra-magica/assets/ui/tierra-magica-banner-final.jpg" alt="Tierra Mágica — Historias que dejan huella" />
  </header>

  <nav class="tm-tabs tm-v03-page-tabs tabs" data-group="primary" aria-label="Páginas de la ficha">
    {{#if creation.isBuilding}}
      <span class="tm-v10-tab-locked"><i class="fa-solid fa-user"></i><span>Ficha</span></span>
      <span class="tm-v10-tab-locked"><i class="fa-solid fa-list-check"></i><span>Habilidades</span></span>
      <span class="tm-v10-tab-locked"><i class="fa-solid fa-swords"></i><span>Combate</span></span>
      <span class="tm-v10-tab-locked"><i class="fa-solid fa-wand-sparkles"></i><span>Magia</span></span>
      <a class="item" data-tab="development"><i class="fa-solid fa-diagram-project"></i><span>Creación</span></a>
      <span class="tm-v10-tab-locked"><i class="fa-solid fa-backpack"></i><span>Equipo</span></span>
      <span class="tm-v10-tab-locked"><i class="fa-solid fa-feather"></i><span>Historia</span></span>
    {{else}}
      <a class="item" data-tab="summary"><i class="fa-solid fa-user"></i><span>Ficha</span></a>
      <a class="item" data-tab="skills"><i class="fa-solid fa-list-check"></i><span>Habilidades</span></a>
      <a class="item" data-tab="combat"><i class="fa-solid fa-swords"></i><span>Combate</span></a>
      <a class="item" data-tab="magic"><i class="fa-solid fa-wand-sparkles"></i><span>Magia</span></a>
      <a class="item" data-tab="development"><i class="fa-solid fa-diagram-project"></i><span>Desarrollo</span></a>
      <a class="item" data-tab="inventory"><i class="fa-solid fa-backpack"></i><span>Equipo</span></a>
      <a class="item" data-tab="biography"><i class="fa-solid fa-feather"></i><span>Historia</span></a>
    {{/if}}
  </nav>

  <section class="tm-sheet-body tm-v03-body">
    <div class="tab" data-group="primary" data-tab="summary">
      <div class="tm-v03-dashboard">

        <aside class="tm-v03-left-rail">
          <section class="tm-v03-panel tm-v03-skills-panel tm-v03-skills-quick">
            <header class="tm-v03-panel-heading">
              <h2>Habilidades</h2>
            </header>

            <div class="tm-v03-quick-skill-list">
              {{#each skillGroups as |group|}}
                {{#each group.skills as |skill|}}
                  <button type="button" class="tm-v03-quick-skill" data-action="roll-skill" data-key="{{skill.key}}" title="{{skill.description}}">
                    <span>{{skill.label}}</span>
                    <b>{{skill.bonusDisplay}}</b>
                  </button>
                {{/each}}
              {{/each}}
            </div>
          </section>
        </aside>

        <main class="tm-v03-character-stage">
          <div class="tm-v03-stage-stars" aria-hidden="true"></div>
          <div class="tm-v03-stage-runes" aria-hidden="true"></div>
          <div class="tm-v03-stage-ring" aria-hidden="true"></div>

          <button type="button" class="tm-v03-attribute tm-v03-int" data-action="roll-attribute" data-key="int" title="INT · clic para tirar; Mayús para configurar"><span>INT</span><b>{{system.attributes.int.value}}</b><i class="fa-solid fa-book-open" aria-hidden="true"></i></button>
          <button type="button" class="tm-v03-attribute tm-v03-per" data-action="roll-attribute" data-key="per" title="PER · clic para tirar; Mayús para configurar"><span>PER</span><b>{{system.attributes.per.value}}</b><i class="fa-solid fa-eye" aria-hidden="true"></i></button>
          <button type="button" class="tm-v03-attribute tm-v03-vol" data-action="roll-attribute" data-key="vol" title="VOL · clic para tirar; Mayús para configurar"><span>VOL</span><b>{{system.attributes.vol.value}}</b><i class="fa-solid fa-fire-flame-curved" aria-hidden="true"></i></button>
          <button type="button" class="tm-v03-attribute tm-v03-agi" data-action="roll-attribute" data-key="agi" title="AGI · clic para tirar; Mayús para configurar"><span>AGI</span><b>{{system.attributes.agi.value}}</b><i class="fa-solid fa-person-running" aria-hidden="true"></i></button>
          <button type="button" class="tm-v03-attribute tm-v03-pre" data-action="roll-attribute" data-key="pre" title="PRE · clic para tirar; Mayús para configurar"><span>PRE</span><b>{{system.attributes.pre.value}}</b><i class="fa-solid fa-star" aria-hidden="true"></i></button>
          <button type="button" class="tm-v03-attribute tm-v03-fue" data-action="roll-attribute" data-key="fue" title="FUE · clic para tirar; Mayús para configurar"><span>FUE</span><b>{{system.attributes.fue.value}}</b><i class="fa-solid fa-hand-fist" aria-hidden="true"></i></button>
          <button type="button" class="tm-v03-attribute tm-v03-vig" data-action="roll-attribute" data-key="vig" title="VIG · clic para tirar; Mayús para configurar"><span>VIG</span><b>{{system.attributes.vig.value}}</b><i class="fa-solid fa-shield" aria-hidden="true"></i></button>

          <div class="tm-v03-portrait-frame">
            <img class="profile-img tm-v03-portrait" src="{{actor.img}}" data-edit="img" title="Cambiar retrato de {{actor.name}}" />
            <div class="tm-v03-portrait-caption tm-v11-portrait-identity">
              <input class="tm-v11-character-name" name="name" type="text" value="{{actor.name}}" aria-label="Nombre del personaje" />
              <small>
                {{#if creation.isBuilding}}
                  Creación guiada · Paso {{creationWizard.step}} de {{creationWizard.total}}
                {{else}}
                  {{#if identityItems.ancestry}}{{identityItems.ancestry.name}}{{else}}Sin Ascendencia{{/if}}
                  · {{#if identityItems.origin}}{{identityItems.origin.name}}{{else}}Sin Origen{{/if}}
                  · {{#if identityItems.background}}{{identityItems.background.name}}{{else}}Sin Trasfondo{{/if}}
                {{/if}}
              </small>
            </div>
          </div>

          <section class="tm-v03-resources">
            <article class="tm-v03-resource tm-v03-health" style="--tm-fill: {{healthPercent}}%;">
              <div class="tm-v03-resource-label"><i class="fa-solid fa-heart"></i><span>Vida</span></div>
              <div class="tm-v03-resource-value">
                <button type="button" data-action="resource-change" data-resource="health" data-amount="-1"><i class="fa-solid fa-minus"></i></button>
                <input type="number" name="system.resources.health.value" value="{{system.resources.health.value}}" />
                <b>/ {{system.derived.healthMax}}</b>
                <button type="button" data-action="resource-change" data-resource="health" data-amount="1"><i class="fa-solid fa-plus"></i></button>
              </div>
              <div class="tm-v03-resource-track"><i></i></div>
            </article>

            <article class="tm-v03-resource tm-v03-mana" style="--tm-fill: {{manaPercent}}%;">
              <div class="tm-v03-resource-label"><i class="fa-solid fa-sparkles"></i><span>Maná</span></div>
              <div class="tm-v03-resource-value">
                <button type="button" data-action="resource-change" data-resource="mana" data-amount="-1"><i class="fa-solid fa-minus"></i></button>
                <input type="number" name="system.resources.mana.value" value="{{system.resources.mana.value}}" />
                <b>/ {{system.derived.manaMax}}</b>
                <button type="button" data-action="resource-change" data-resource="mana" data-amount="1"><i class="fa-solid fa-plus"></i></button>
              </div>
              <div class="tm-v03-resource-track"><i></i></div>
            </article>

            <article class="tm-v03-resource tm-v03-development">
              <div class="tm-v03-resource-label"><i class="fa-solid fa-compass-drafting"></i><span>Desarrollo</span></div>
              <div class="tm-v03-pd-value"><strong>{{development.pdAvailable}}</strong><small>disponibles</small><b>{{development.pdTotal}}</b><small>totales</small></div>
            </article>
          </section>

          <section class="tm-v03-turn">
            <div class="tm-v03-turn-heading">
              <span>Turno</span>
              <button type="button" data-action="reset-turn" title="Restablecer Movimiento, Acción y Reacción"><i class="fa-solid fa-rotate-right"></i></button>
            </div>
            <div class="tm-v03-turn-actions">
              <button type="button" class="{{#if turn.movementDepleted}}spent{{/if}}" data-action="spend-movement">
                <i class="fa-solid fa-person-running"></i>
                <span>Movimiento</span>
                <small>{{turn.movementRemaining}} / {{turn.movementMax}} esp.</small>
              </button>
              <button type="button" class="{{#unless turn.action}}spent{{/unless}}" data-action="toggle-turn" data-key="action" title="Marcador manual de Acción; no bloquea ataques, magia ni otras resoluciones">
                <i class="fa-solid fa-bolt"></i>
                <span>Acción</span>
                <small>{{#if turn.action}}Disponible{{else}}Gastada{{/if}}</small>
              </button>
              <button type="button" class="{{#unless turn.reaction}}spent{{/unless}}" data-action="toggle-turn" data-key="reaction" title="Marcador manual de Reacción; no bloquea respuestas ni otras resoluciones">
                <i class="fa-solid fa-shield-halved"></i>
                <span>Reacción</span>
                <small>{{#if turn.reaction}}Disponible{{else}}Gastada{{/if}}</small>
              </button>
            </div>
          </section>

          <div class="tm-v09-motto" aria-hidden="true">
            <span>✦</span><b>EXPLORA</b><i>•</i><b>CREA</b><i>•</i><b>ENFRENTA</b><i>•</i><b>TRASCIENDE</b><span>✦</span>
          </div>
        </main>

        <aside class="tm-v03-right-rail">
          <section class="tm-v03-panel tm-v03-defenses">
            <header class="tm-v03-panel-heading">
              <h2>Defensas</h2>
            </header>
            <div class="tm-v03-defense-grid">
              <div class="tm-v09-defense tm-v09-defense-general" title="Defensa: ataques físicos o energéticos ordinarios."><i class="fa-solid fa-shield-halved"></i><span>Defensa</span><small>Ataques</small><b>{{system.derived.defense}}</b></div>
              <div class="tm-v09-defense tm-v09-defense-maneuver" title="Defensa de Maniobra: Derribar, Empujar y Agarrar."><i class="fa-solid fa-swords"></i><span>Maniobra</span><small>Derribar · Empujar</small><b>{{system.derived.maneuverDefense}}</b></div>
              <div class="tm-v09-defense tm-v09-defense-mental" title="Defensa Mental: influencia y efectos mentales resistidos."><i class="fa-solid fa-brain"></i><span>Mental</span><small>Mente</small><b>{{system.derived.mentalDefense}}</b></div>
              <div class="tm-v09-defense tm-v09-defense-body" title="Defensa Corporal: efectos que alteran directamente el cuerpo."><i class="fa-solid fa-person"></i><span>Corporal</span><small>Cuerpo</small><b>{{system.derived.bodyDefense}}</b></div>
            </div>
            <div class="tm-v03-derived-list">
              <button type="button" data-action="roll-initiative"><span>Iniciativa</span><b>+{{system.derived.initiativeModifier}}</b><i class="fa-solid fa-dice"></i></button>
              <div><span>Protección</span><b>{{system.derived.protection}}</b></div>
              <div><span>Daño Grave</span><b>{{system.derived.severeThreshold}}</b></div>
              <div><span>Movimiento</span><b>{{system.derived.movement}}</b></div>
            </div>
          </section>

          {{#if creationGuide.ancestryProfile}}
            <section class="tm-v03-panel tm-v03-list-panel tm-v03-ancestry-panel">
              <header class="tm-v03-panel-heading"><h2>Ascendencia · {{creationGuide.ancestryProfile.name}}</h2></header>
              <div class="tm-v03-derived-list">
                <div><span>Escala</span><b>{{creationGuide.ancestryScaleLabel}}</b></div>
                <div><span>Movimiento</span><b>{{creationGuide.ancestryProfile.movementBase}}</b></div>
                {{#if creationGuide.ancestryProfile.movementModes}}<div><span>Movimiento especial</span><b>{{creationGuide.ancestryProfile.movementModes}}</b></div>{{/if}}
                {{#if creationGuide.ancestryProfile.naturalProtection}}<div><span>Protección Natural</span><b>{{creationGuide.ancestryProfile.naturalProtection}}</b></div>{{/if}}
              </div>
              <ol class="tm-v03-mini-list">
                {{#each creationGuide.ancestryProfile.features as |feature|}}
                  <li><span>{{feature}}</span></li>
                {{/each}}
              </ol>
            </section>
          {{/if}}

          <section class="tm-v03-panel tm-v03-state">
            <header class="tm-v03-panel-heading"><h2>Estado</h2></header>
            <div class="tm-v03-state-grid">
              <label><span>Trauma</span><select name="system.status.trauma">{{selectOptions config.trauma selected=system.status.trauma}}</select></label>
              <label><span>Fatiga</span><select name="system.status.fatigue">{{selectOptions config.fatigue selected=system.status.fatigue}}</select></label>
              <label><span>Sangrado</span><input type="number" name="system.status.bleeding" value="{{system.status.bleeding}}" min="0" max="2" /></label>
              <label class="tm-v03-condition"><span>Condiciones</span><input type="text" name="system.status.conditions" value="{{system.status.conditions}}" placeholder="Derribado, Agarrado..." /></label>
            </div>
          </section>

          <section class="tm-v03-panel tm-v03-list-panel">
            <header class="tm-v03-panel-heading"><h2>Rasgos</h2></header>
            <ol class="tm-v03-mini-list">
              {{#each itemGroups.trait as |item|}}
                <li class="item" data-item-id="{{item.id}}"><button type="button" data-action="item-edit"><span>{{item.name}}</span><small>{{lookup @root.config.traitCategories item.system.category}}</small></button></li>
              {{else}}<li class="tm-v03-empty">Sin rasgos registrados.</li>{{/each}}
            </ol>
          </section>

          <section class="tm-v03-panel tm-v03-list-panel">
            <header class="tm-v03-panel-heading"><h2>Especializaciones</h2></header>
            <ol class="tm-v03-mini-list">
              {{#each itemGroups.specialization as |item|}}
                <li class="item" data-item-id="{{item.id}}"><button type="button" data-action="item-edit"><span>{{item.name}}</span><small>{{item.system.skill}}</small></button></li>
              {{else}}<li class="tm-v03-empty">Sin especializaciones.</li>{{/each}}
            </ol>
          </section>

          <section class="tm-v03-panel tm-v03-list-panel">
            <header class="tm-v03-panel-heading"><h2>Técnicas</h2></header>
            <ol class="tm-v03-mini-list">
              {{#each itemGroups.technique as |item|}}
                <li class="item" data-item-id="{{item.id}}"><button type="button" data-action="item-edit"><span>{{item.name}}</span><small>{{lookup @root.config.techniqueGrades item.system.grade}} · {{item.system.pdCost}} PD</small></button></li>
              {{else}}<li class="tm-v03-empty">Sin técnicas registradas.</li>{{/each}}
            </ol>
          </section>

          <section class="tm-panel tm-v03-page-panel">
            <div class="tm-section-heading"><h2>Familiar</h2><span>Compañero independiente vinculado.</span></div>
            <button type="button" class="tm-v03-familiar" data-action="open-familiar">
              {{#if familiar}}<img src="{{familiar.img}}" alt="" /><span><b>{{familiar.name}}</b><small>Abrir ficha</small></span>
              {{else}}<i class="fa-solid fa-paw"></i><span><b>Familiar</b><small>Crear vínculo</small></span>{{/if}}
            </button>
            {{#if familiar}}
              <div class="tm-section-buttons">
                <button type="button" data-action="familiar-linked-action">Acción Vinculada (Reacción)</button>
                <button type="button" data-action="familiar-command">Nueva orden (Acción)</button>
                <button type="button" data-action="familiar-call">Llamar</button>
                {{#if familiar.system.familiar.sharedSenses}}<button type="button" data-action="familiar-senses">Sentidos Compartidos (Acción)</button>{{/if}}
              </div>
              <p><small>El vínculo transmite de forma aproximada emociones/conceptos simples; no es GPS, telepatía perfecta ni obediencia absoluta.</small></p>
            {{/if}}
          </section>

          <div class="tm-v03-rest-actions">
            <button type="button" data-action="rest" data-kind="breather"><i class="fa-solid fa-mug-hot"></i> Respiro (~10 min)</button>
            <button type="button" data-action="rest" data-kind="rest"><i class="fa-solid fa-campground"></i> Descanso (~1 h)</button>
            <button type="button" data-action="rest" data-kind="full"><i class="fa-solid fa-bed"></i> Descanso completo (~8 h)</button>
          </div>
        </aside>
      </div>
    </div>

    <div class="tab" data-group="primary" data-tab="skills">
      <section class="tm-v03-page-hero tm-v03-skills-hero">
        <i class="fa-solid fa-list-check"></i>
        <div>
          <small>Página de habilidades</small>
          <h2>Habilidades</h2>
          <p>Rangos, modificadores automáticos, temporales y fuentes que componen cada valor final.</p>
        </div>
        <button type="button" class="tm-v04-clear-temporaries" data-action="clear-skill-temporaries" title="Poner todos los modificadores temporales en 0">
          <i class="fa-solid fa-eraser"></i>
          <span>Limpiar temporales</span>
        </button>
      </section>

      {{#if development.skillIssues.length}}
        <section class="tm-panel tm-v03-page-panel tm-v11-skill-alert">
          <div class="tm-warning">
            <strong>Hay Habilidades que requieren revisión</strong>
            <ul>{{#each development.skillIssues as |issue|}}<li>{{issue}}</li>{{/each}}</ul>
          </div>
        </section>
      {{else}}
        {{#if development.skillBuildActive}}
          <div class="tm-v11-skill-build-status"><i class="fa-solid fa-compass-drafting"></i><span>En creación · {{development.skillsPdCost}} PD invertidos en Habilidades</span></div>
        {{/if}}
      {{/if}}

      <section class="tm-v03-skills-page">
        {{#each skillGroups as |group|}}
          <section class="tm-v03-panel tm-v03-skill-category">
            <header class="tm-v03-skill-category-heading">
              <i class="fa-solid {{group.icon}}"></i>
              <h3>{{group.label}}</h3>
            </header>

            <div class="tm-v03-skill-category-list tm-v04-skill-category-list">
              {{#each group.skills as |skill|}}
                <article class="tm-v04-skill-detail">
                  <div class="tm-v04-skill-main">
                    <button type="button" class="tm-v04-skill-name" data-action="roll-skill" data-key="{{skill.key}}" title="Tirar {{skill.label}}">
                      <span>{{skill.label}}</span>
                      <i class="fa-solid fa-dice"></i>
                    </button>

                    <select data-action="set-skill-rank" data-key="{{skill.key}}" title="Rango de {{skill.label}}">
                      {{selectOptions @root.config.rankOptionLabels selected=skill.rank}}
                    </select>

                    <div class="tm-v04-skill-total" title="Modificador final de la Habilidad">
                      <small>Total</small>
                      <b>{{skill.bonusDisplay}}</b>
                    </div>

                    <button type="button" class="tm-v04-roll-button" data-action="roll-skill" data-key="{{skill.key}}" title="Tirar {{skill.label}}">
                      <i class="fa-solid fa-dice-d10"></i>
                    </button>
                  </div>

                  <div class="tm-v04-skill-breakdown">
                    {{#each skill.modifierSummary as |modifier|}}
                      <span class="tm-v04-modifier-chip tm-v04-modifier-{{modifier.key}}">
                        <small>{{modifier.label}}</small>
                        <b>{{modifier.display}}</b>
                      </span>
                    {{/each}}

                    <label class="tm-v04-manual-modifier">
                      <small>Temporal</small>
                      <input type="number" value="{{skill.temporary}}" data-action="set-skill-temporary" data-key="{{skill.key}}" title="Modificador temporal" />
                    </label>

                    <label class="tm-v04-manual-modifier">
                      <small>Otros</small>
                      <input type="number" value="{{skill.other}}" data-action="set-skill-other" data-key="{{skill.key}}" title="Otro modificador manual" />
                    </label>
                  </div>

                  {{#if skill.sources.length}}
                    <div class="tm-v04-skill-sources">
                      <span class="tm-v04-sources-title"><i class="fa-solid fa-link"></i> Fuentes activas</span>
                      <div class="tm-v04-source-list">
                        {{#each skill.sources as |source|}}
                          <button type="button" class="tm-v04-source" data-action="skill-source-open" data-item-id="{{source.itemId}}" title="Abrir {{source.name}}">
                            <span>
                              <b>{{source.name}}</b>
                              <small>{{source.categoryLabel}}{{#if source.label}} · {{source.label}}{{/if}}</small>
                            </span>
                            <strong>{{source.display}}</strong>
                          </button>
                        {{/each}}
                      </div>
                    </div>
                  {{/if}}

                  {{#if skill.linkedSpecializations.length}}
                    <div class="tm-v04-linked-specializations">
                      <span>Especializaciones:</span>
                      {{#each skill.linkedSpecializations as |specialization|}}
                        <button type="button" data-action="skill-source-open" data-item-id="{{specialization.id}}">{{specialization.name}}</button>
                      {{/each}}
                    </div>
                  {{/if}}
                </article>
              {{/each}}
            </div>
          </section>
        {{/each}}
      </section>

      <section class="tm-v03-skills-support-grid">
        <section class="tm-v03-panel tm-v03-page-panel">
          <div class="tm-section-heading"><h2>Especializaciones</h2><span>Relacionadas con tus Habilidades.</span></div>
          <ol class="tm-v03-mini-list">
            {{#each itemGroups.specialization as |item|}}
              <li class="item" data-item-id="{{item.id}}">
                <button type="button" data-action="item-edit">
                  <span>{{item.name}}</span>
                  <small>{{item.system.skill}}</small>
                </button>
              </li>
            {{else}}
              <li class="tm-v03-empty">Sin especializaciones registradas.</li>
            {{/each}}
          </ol>
        </section>

        <section class="tm-v03-panel tm-v03-page-panel">
          <div class="tm-section-heading"><h2>Técnicas</h2><span>Capacidades ligadas a tu entrenamiento.</span></div>
          <ol class="tm-v03-mini-list">
            {{#each itemGroups.technique as |item|}}
              <li class="item" data-item-id="{{item.id}}">
                <button type="button" data-action="item-edit">
                  <span>{{item.name}}</span>
                  <small>{{lookup @root.config.techniqueGrades item.system.grade}} · {{item.system.pdCost}} PD</small>
                </button>
              </li>
            {{else}}
              <li class="tm-v03-empty">Sin técnicas registradas.</li>
            {{/each}}
          </ol>
        </section>
      </section>
    </div>

    <div class="tab" data-group="primary" data-tab="combat">
      <section class="tm-v03-page-hero">
        <i class="fa-solid fa-swords"></i>
        <div><small>Página de combate</small><h2>Combate</h2><p>Lo que necesitás para atacar, defenderte y reaccionar durante un enfrentamiento.</p></div>
      </section>

      <section class="tm-v11-combat-overview" aria-label="Resumen de combate">
        <article title="Ataques físicos o energéticos ordinarios"><span>Defensa</span><b>{{system.derived.defense}}</b><small>Ataques</small></article>
        <article title="Derribar, Empujar y Agarrar"><span>Maniobra</span><b>{{system.derived.maneuverDefense}}</b><small>Control físico</small></article>
        <article title="Efectos que alteran directamente el cuerpo"><span>Corporal</span><b>{{system.derived.bodyDefense}}</b><small>Cuerpo</small></article>
        <article title="Influencia y efectos mentales resistidos"><span>Mental</span><b>{{system.derived.mentalDefense}}</b><small>Mente</small></article>
        <article><span>Protección</span><b>{{system.derived.protection}}</b><small>Reduce daño</small></article>
        <article><span>Movimiento</span><b>{{system.derived.movement}}</b><small>espacios</small></article>
        <button type="button" data-action="roll-initiative"><span>Iniciativa</span><b>+{{system.derived.initiativeModifier}}</b><small><i class="fa-solid fa-dice"></i> Tirar</small></button>
      </section>

      <section class="tm-panel tm-v03-page-panel tm-v11-defense-actions">
        <div class="tm-section-heading"><h2>Respuestas defensivas</h2><span>Elegí una respuesta cuando exista un disparador válido.</span></div>
        <div class="tm-v11-defense-action-grid">
          <button type="button" class="{{#unless turn.action}}spent{{/unless}}" data-action="combat-guard">
            <i class="fa-solid fa-shield"></i><span><b>Guardia</b><small>Acción · +2 Defensa</small></span>
          </button>
          <button type="button" class="{{#unless turn.reaction}}spent{{/unless}}" data-action="combat-parry">
            <i class="fa-solid fa-swords"></i><span><b>Parada</b><small>Reacción · ataque parable</small></span>
          </button>
          <button type="button" class="{{#unless turn.reaction}}spent{{/unless}}" data-action="combat-counterattack">
            <i class="fa-solid fa-arrow-rotate-left"></i><span><b>Contraataque</b><small>Tras una Parada válida</small></span>
          </button>
        </div>
      </section>

      {{#if isGM}}
        <details class="tm-panel tm-v03-page-panel tm-v11-advanced-panel">
          <summary><span><i class="fa-solid fa-sliders"></i> Configuración avanzada de combate</span><small>DJ · ajustes manuales y valores base</small></summary>
          <div class="tm-form-grid tm-v11-advanced-grid">
            <label><span>Rango marcial defensivo</span><select disabled>{{selectOptions config.rankLabels selected=system.combat.defensiveRank}}</select></label>
            <label><span>Movimiento base</span><input type="number" name="system.movement.base" value="{{system.movement.base}}" min="1" /></label>
            <label><span>Ajuste Defensa</span><input type="number" name="system.modifiers.manual.defensiveBonus.value" value="{{system.modifiers.manual.defensiveBonus.value}}" /></label>
            <label><span>Ajuste Protección</span><input type="number" name="system.modifiers.manual.protection.value" value="{{system.modifiers.manual.protection.value}}" /></label>
            <label><span>Ajuste Movimiento</span><input type="number" name="system.modifiers.manual.movement.value" value="{{system.modifiers.manual.movement.value}}" /></label>
            <label><span>Ajuste Iniciativa</span><input type="number" name="system.modifiers.manual.initiativeModifier.value" value="{{system.modifiers.manual.initiativeModifier.value}}" /></label>
          </div>
        </details>
      {{/if}}

      {{> "systems/tierra-magica/templates/actor/parts/item-section.hbs" title="Armas preparadas" type="weapon" items=itemGroups.weapon}}
      {{> "systems/tierra-magica/templates/actor/parts/item-section.hbs" title="Armaduras" type="armor" items=itemGroups.armor}}
      {{> "systems/tierra-magica/templates/actor/parts/item-section.hbs" title="Escudos" type="shield" items=itemGroups.shield}}
      {{> "systems/tierra-magica/templates/actor/parts/item-section.hbs" title="Técnicas" type="technique" items=itemGroups.technique}}
    </div>

    <div class="tab" data-group="primary" data-tab="magic">
      <section class="tm-v03-page-hero tm-v03-magic-hero tm-v11-magic-hero">
        <i class="fa-solid fa-wand-sparkles"></i>
        <div><small>Página de magia</small><h2>Magia</h2><p>Tu reserva, entrenamiento mágico y hechizos disponibles en una sola vista.</p></div>
        <div class="tm-v03-hero-resource"><span>Maná</span><b>{{system.resources.mana.value}}</b><small>/ {{system.derived.manaMax}}</small></div>
      </section>

      <section class="tm-v11-magic-overview">
        <div class="tm-v11-magic-skills" aria-label="Competencias mágicas">
          <span><small>Canalización</small><b>+{{system.skills.channeling.bonus}}</b></span>
          <span><small>Ritualismo</small><b>+{{system.skills.ritualism.bonus}}</b></span>
          <span><small>Arcana</small><b>+{{system.skills.arcana.bonus}}</b></span>
        </div>
        <div class="tm-v11-discipline-summary">
          <div class="tm-v11-section-title">
            <span><i class="fa-solid fa-circle-nodes"></i><b>Disciplinas</b></span>
            <div>
              <button type="button" class="tm-icon-button" data-action="content-browser" data-type="discipline"><i class="fa-solid fa-book"></i> Catálogo</button>
              {{#if editable}}<button type="button" class="tm-icon-button" data-action="item-create" data-type="discipline"><i class="fa-solid fa-plus"></i> Agregar</button>{{/if}}
            </div>
          </div>
          <div class="tm-v11-discipline-list">
            {{#each itemGroups.discipline as |item|}}
              <article class="item tm-v11-discipline-card" data-item-id="{{item.id}}">
                <i class="fa-solid fa-diagram-project"></i>
                <span><b>{{item.name}}</b><small>Disciplina · {{item.system.pdCost}} PD</small></span>
                <button type="button" class="tm-icon-button" data-action="item-edit" title="Editar"><i class="fa-solid fa-pen-to-square"></i></button>
                {{#if @root.editable}}<button type="button" class="tm-icon-button tm-danger" data-action="item-delete" title="Eliminar"><i class="fa-solid fa-trash"></i></button>{{/if}}
              </article>
            {{else}}
              <p class="tm-v11-empty-inline">No hay Disciplinas registradas.</p>
            {{/each}}
          </div>
        </div>
      </section>

      {{#if sustainedSpells.length}}
        <section class="tm-panel tm-v03-page-panel tm-v11-sustained-active">
          <div class="tm-section-heading"><h2>Sostenimiento</h2><span>Un efecto demandante; Doble Sostenimiento permite dos.</span></div>
          <ol class="tm-item-list">
            {{#each sustainedSpells as |spell|}}
              <li class="tm-item-row"><div class="tm-item-name"><strong>{{spell.name}}</strong><small>Efecto sostenido activo</small></div><button type="button" data-action="stop-sustained" data-item-id="{{spell.id}}">Abandonar</button></li>
            {{/each}}
          </ol>
        </section>
      {{else}}
        <div class="tm-v11-sustained-empty"><i class="fa-solid fa-link-slash"></i><span>Sin efectos sostenidos demandantes.</span></div>
      {{/if}}

      <section class="tm-panel tm-v03-page-panel tm-v11-grimoire">
        <div class="tm-section-heading">
          <div><h2>Grimorio</h2><small>Hechizos que conocés y podés intentar lanzar.</small></div>
          <div class="tm-section-buttons">
            <button type="button" class="tm-icon-button" data-action="content-browser" data-type="spell"><i class="fa-solid fa-book"></i> Catálogo</button>
            {{#if editable}}<button type="button" class="tm-icon-button" data-action="item-create" data-type="spell"><i class="fa-solid fa-plus"></i> Agregar</button>{{/if}}
          </div>
        </div>
        <div class="tm-v11-spell-list">
          {{#each itemGroups.spell as |item|}}
            <article class="item tm-v11-spell-card" data-item-id="{{item.id}}">
              <img src="{{item.img}}" alt="" />
              <div class="tm-v11-spell-info">
                <div class="tm-v11-spell-title"><strong>{{item.name}}</strong><span>{{item.system.manaCost}} Maná</span></div>
                <div class="tm-v11-spell-tags">
                  <span>{{lookup @root.config.disciplines item.system.discipline}}</span>
                  <span>{{lookup @root.config.sources item.system.source}}</span>
                  <span>{{lookup @root.config.spellMethods item.system.method}}</span>
                  <span>{{item.system.activation}}</span>
                  {{#if item.system.duration}}<span>{{item.system.duration}}</span>{{/if}}
                  {{#if item.system.range}}<span>{{item.system.range}}</span>{{/if}}
                </div>
              </div>
              <div class="tm-v11-spell-actions">
                <button type="button" class="tm-v11-cast-button" data-action="item-spell"><i class="fa-solid fa-wand-sparkles"></i> Lanzar</button>
                <button type="button" class="tm-icon-button" data-action="item-edit" title="Editar"><i class="fa-solid fa-pen-to-square"></i></button>
                {{#if @root.editable}}<button type="button" class="tm-icon-button tm-danger" data-action="item-delete" title="Eliminar"><i class="fa-solid fa-trash"></i></button>{{/if}}
              </div>
            </article>
          {{else}}
            <div class="tm-empty">No hay Hechizos en el Grimorio.</div>
          {{/each}}
        </div>
      </section>

      <section class="tm-v11-secondary-magic">
        <div class="tm-v11-secondary-heading"><span>Otras artes y recursos</span><small>Alquimia, Rituales y tecnología arcano-industrial.</small></div>
        {{> "systems/tierra-magica/templates/actor/parts/item-section.hbs" title="Preparaciones alquímicas" type="formula" items=itemGroups.formula}}
        {{> "systems/tierra-magica/templates/actor/parts/item-section.hbs" title="Rituales" type="ritual" items=itemGroups.ritual}}
        {{> "systems/tierra-magica/templates/actor/parts/item-section.hbs" title="Dispositivos arcano-industriales" type="device" items=itemGroups.device}}
      </section>
    </div>

    <div class="tab" data-group="primary" data-tab="development">
      {{#if creation.isBuilding}}
        <section class="tm-v03-page-hero tm-v10-creation-hero">
          <i class="fa-solid fa-person-circle-plus"></i>
          <div>
            <small>Creación de personaje</small>
            <h2>Paso {{creationWizard.step}} de {{creationWizard.total}}</h2>
            <p>Completá un paso para desbloquear el siguiente. El resto de la ficha se habilita al finalizar.</p>
          </div>
        </section>

        <section class="tm-v10-wizard-steps" aria-label="Progreso de creación">
          {{#each creationWizard.steps as |step|}}
            <div class="tm-v10-wizard-step {{#if step.active}}active{{/if}} {{#if step.done}}done{{/if}} {{#if step.locked}}locked{{/if}}">
              <b>{{step.number}}</b><span>{{step.label}}</span>
            </div>
          {{/each}}
        </section>

        {{#if creationWizard.isStep1}}
          <section class="tm-panel tm-v03-page-panel tm-v10-wizard-card">
            <div class="tm-section-heading"><h2>1 · Elegí tu Ascendencia</h2><span>Define el paquete racial del personaje.</span></div>
            {{#if identityItems.ancestry}}
              <div class="tm-v10-choice-selected">
                <div><small>Ascendencia elegida</small><strong>{{identityItems.ancestry.name}}</strong><p>{{identityItems.ancestry.system.description}}</p></div>
                <button type="button" data-action="content-browser" data-type="ancestry">Cambiar</button>
              </div>
              {{#if creationGuide.ancestryProfile}}
                <div class="tm-v10-racial-preview">
                  <span>Escala <b>{{creationGuide.ancestryScaleLabel}}</b></span>
                  <span>Movimiento <b>{{creationGuide.ancestryProfile.movementBase}}</b></span>
                  {{#if creationGuide.ancestryProfile.movementModes}}<span>Especial <b>{{creationGuide.ancestryProfile.movementModes}}</b></span>{{/if}}
                  {{#if creationGuide.ancestryProfile.naturalProtection}}<span>Protección Natural <b>{{creationGuide.ancestryProfile.naturalProtection}}</b></span>{{/if}}
                </div>
                {{#if creationGuide.ancestryProfile.features.length}}
                  <ul class="tm-v10-feature-list">{{#each creationGuide.ancestryProfile.features as |feature|}}<li>{{feature}}</li>{{/each}}</ul>
                {{/if}}
              {{/if}}
            {{else}}
              <div class="tm-v10-empty-choice">
                <i class="fa-solid fa-users"></i>
                <p>Todavía no elegiste Ascendencia.</p>
                <button type="button" data-action="content-browser" data-type="ancestry">Elegir Ascendencia</button>
              </div>
            {{/if}}
          </section>
        {{/if}}

        {{#if creationWizard.isStep2}}
          <section class="tm-panel tm-v03-page-panel tm-v10-wizard-card">
            <div class="tm-section-heading"><h2>2 · Elegí tu Origen</h2><span>El Origen fija familiaridad cultural, idiomas y una Faceta.</span></div>
            {{#if identityItems.origin}}
              <div class="tm-v10-choice-selected">
                <div><small>Origen elegido</small><strong>{{identityItems.origin.name}}</strong><p>{{identityItems.origin.system.description}}</p></div>
                <button type="button" data-action="content-browser" data-type="origin">Cambiar</button>
              </div>
              <div class="tm-v10-wizard-fields">
                <label><span>Faceta de Origen</span><select data-action="set-origin-facet">{{selectOptions creationGuide.originFacetOptions selected=creationGuide.originFacet}}</select></label>
                <label><span>Idiomas iniciales</span><input type="text" value="{{creationGuide.languages}}" readonly /></label>
              </div>
            {{else}}
              <div class="tm-v10-empty-choice"><i class="fa-solid fa-map-location-dot"></i><p>Todavía no elegiste Origen.</p><button type="button" data-action="content-browser" data-type="origin">Elegir Origen</button></div>
            {{/if}}
          </section>
        {{/if}}

        {{#if creationWizard.isStep3}}
          <section class="tm-panel tm-v03-page-panel tm-v10-wizard-card">
            <div class="tm-section-heading"><h2>3 · Elegí tu Trasfondo</h2><span>Seleccioná el Trasfondo y exactamente dos Facetas.</span></div>
            {{#if identityItems.background}}
              <div class="tm-v10-choice-selected">
                <div><small>Trasfondo elegido</small><strong>{{identityItems.background.name}}</strong><p>{{identityItems.background.system.description}}</p></div>
                <button type="button" data-action="content-browser" data-type="background">Cambiar</button>
              </div>
              <div class="tm-v10-wizard-fields tm-v10-background-facets">
                <label><span>Faceta 1</span><select data-action="set-background-facet" data-index="0">{{selectOptions creationGuide.backgroundFacetOptions selected=creationGuide.backgroundFacet1}}</select></label>
                <label><span>Faceta 2</span><select data-action="set-background-facet" data-index="1">{{selectOptions creationGuide.backgroundFacetOptions selected=creationGuide.backgroundFacet2}}</select></label>
                {{#if creationGuide.usesWorkLanguage}}<label><span>Idioma de trabajo</span><input type="text" data-action="set-background-work-language" value="{{creationGuide.workLanguage}}" placeholder="Idioma regional adicional" /></label>{{/if}}
              </div>
            {{else}}
              <div class="tm-v10-empty-choice"><i class="fa-solid fa-briefcase"></i><p>Todavía no elegiste Trasfondo.</p><button type="button" data-action="content-browser" data-type="background">Elegir Trasfondo</button></div>
            {{/if}}
          </section>
        {{/if}}

        {{#if creationWizard.isStep4}}
          <section class="tm-panel tm-v03-page-panel tm-v10-wizard-card">
            <div class="tm-section-heading"><h2>4 · Repartí tus Atributos</h2><span>Exactamente 6 aumentos gratuitos; ningún Atributo puede superar 3.</span></div>
            <div class="tm-v10-budget-callout"><strong>{{creationGuide.attributeIncreases}} / {{creationGuide.attributeTarget}}</strong><span>aumentos usados</span></div>
            <div class="tm-v03-attribute-editor tm-v10-attribute-editor">
              {{#each system.attributes as |attribute key|}}
                <label><span>{{lookup ../config.attributes key}}</span><input type="number" data-action="set-creation-attribute" data-key="{{key}}" value="{{attribute.creationValue}}" min="1" max="3" /></label>
              {{/each}}
            </div>
          </section>
        {{/if}}

        {{#if creationWizard.isStep5}}
          <section class="tm-panel tm-v03-page-panel tm-v10-wizard-card">
            <div class="tm-section-heading"><h2>5 · Gastá tus PD</h2><span>Habilidades y opciones de desarrollo. Podés dejar PD sin gastar.</span></div>
            <div class="tm-v10-budget-bar"><span>PD totales <b>{{development.pdTotal}}</b></span><span>Gastados <b>{{development.pdSpent}}</b></span><span>Disponibles <b>{{development.pdAvailable}}</b></span></div>
            {{#if creationWizard.skillIssues.length}}<div class="tm-warning"><strong>Habilidades pendientes</strong><ul>{{#each creationWizard.skillIssues as |issue|}}<li>{{issue}}</li>{{/each}}</ul></div>{{/if}}
            <div class="tm-v10-skill-builder">
              {{#each skillGroups as |group|}}
                <section><h3>{{group.label}}</h3>
                  {{#each group.skills as |skill|}}
                    <label><span>{{skill.label}}</span><select data-action="set-skill-rank" data-key="{{skill.key}}">{{selectOptions @root.config.rankOptionLabels selected=skill.rank}}</select></label>
                  {{/each}}
                </section>
              {{/each}}
            </div>
            <div class="tm-v10-catalog-actions">
              <button type="button" data-action="content-browser" data-type="specialization">+ Especialización</button>
              <button type="button" data-action="content-browser" data-type="technique">+ Técnica</button>
              <button type="button" data-action="content-browser" data-type="discipline">+ Disciplina</button>
              <button type="button" data-action="content-browser" data-type="spell">+ Hechizo</button>
              <button type="button" data-action="content-browser" data-type="formula">+ Fórmula</button>
              <button type="button" data-action="content-browser" data-type="ritual">+ Ritual</button>
            </div>
            <ol class="tm-v10-selected-list">
              {{#each creationWizard.selectedPdItems as |item|}}
                <li class="item" data-item-id="{{item.id}}"><span><b>{{item.name}}</b><small>{{item.type}} · {{item.system.acquisition.paid.amount}} PD</small></span><button type="button" data-action="item-delete" title="Quitar"><i class="fa-solid fa-trash"></i></button></li>
              {{else}}<li class="tm-empty">Sin compras de PD adicionales.</li>{{/each}}
            </ol>
          </section>
        {{/if}}

        {{#if creationWizard.isStep6}}
          <section class="tm-panel tm-v03-page-panel tm-v10-wizard-card">
            <div class="tm-section-heading"><h2>6 · Elegí Rasgos</h2><span>Presupuesto separado de PR. Podés dejar PR sin gastar.</span></div>
            <div class="tm-v10-budget-bar"><span>PR totales <b>{{development.prTotal}}</b></span><span>Gastados <b>{{development.prSpent}}</b></span><span>Disponibles <b>{{development.prAvailable}}</b></span></div>
            <div class="tm-v10-catalog-actions"><button type="button" data-action="content-browser" data-type="trait">+ Elegir Rasgo</button></div>
            <ol class="tm-v10-selected-list">
              {{#each creationWizard.selectedTraitItems as |item|}}
                <li class="item" data-item-id="{{item.id}}"><span><b>{{item.name}}</b><small>{{item.system.description}}</small></span><button type="button" data-action="item-delete" title="Quitar"><i class="fa-solid fa-trash"></i></button></li>
              {{else}}<li class="tm-empty">No elegiste Rasgos todavía.</li>{{/each}}
            </ol>
          </section>
        {{/if}}

        {{#if creationWizard.isStep7}}
          <section class="tm-panel tm-v03-page-panel tm-v10-wizard-card">
            <div class="tm-section-heading"><h2>7 · Comprá Equipo inicial</h2><span>PEI 20 o. El remanente se pierde al completar la creación.</span></div>
            <div class="tm-v10-budget-bar"><span>PEI total <b>{{development.peiTotal}} c</b></span><span>Gastado <b>{{development.peiSpent}} c</b></span><span>Restante <b>{{creationPei.display}}</b></span></div>
            <div class="tm-v10-catalog-actions">
              <button type="button" data-action="content-browser" data-type="weapon">+ Arma</button>
              <button type="button" data-action="content-browser" data-type="armor">+ Armadura</button>
              <button type="button" data-action="content-browser" data-type="shield">+ Escudo</button>
              <button type="button" data-action="content-browser" data-type="equipment">+ Equipo</button>
              <button type="button" data-action="content-browser" data-type="device">+ Dispositivo</button>
            </div>
            <ol class="tm-v10-selected-list">
              {{#each creationWizard.selectedEquipmentItems as |item|}}
                <li class="item" data-item-id="{{item.id}}"><span><b>{{item.name}}</b><small>{{item.type}} · {{item.system.acquisition.paid.amount}} c</small></span><button type="button" data-action="item-delete" title="Quitar"><i class="fa-solid fa-trash"></i></button></li>
              {{else}}<li class="tm-empty">Sin equipo comprado con PEI.</li>{{/each}}
            </ol>
          </section>
        {{/if}}

        {{#if creationWizard.isStep8}}
          <section class="tm-panel tm-v03-page-panel tm-v10-wizard-card tm-v10-review-card">
            <div class="tm-section-heading"><h2>8 · Revisá y completá</h2><span>Al cerrar la creación se desbloquea toda la ficha.</span></div>
            <div class="tm-v10-review-grid">
              <div><span>Ascendencia</span><b>{{identityItems.ancestry.name}}</b></div>
              <div><span>Origen</span><b>{{identityItems.origin.name}}</b><small>{{creationGuide.originFacet}}</small></div>
              <div><span>Trasfondo</span><b>{{identityItems.background.name}}</b><small>{{system.details.backgroundFacets}}</small></div>
              <div><span>Atributos</span><b>{{creationGuide.attributeIncreases}} / {{creationGuide.attributeTarget}}</b></div>
              <div><span>PD disponibles</span><b>{{development.pdAvailable}}</b></div>
              <div><span>PR disponibles</span><b>{{development.prAvailable}}</b></div>
              <div><span>PEI restante</span><b>{{creationPei.display}}</b></div>
              <div><span>Idiomas</span><b>{{creationGuide.languages}}</b></div>
            </div>
            {{#if creationGuide.issues.length}}
              <div class="tm-warning"><strong>Todavía falta resolver</strong><ul>{{#each creationGuide.issues as |issue|}}<li>{{issue.message}}</li>{{/each}}</ul></div>
            {{else}}
              <div class="tm-info"><strong>Personaje listo.</strong> La ficha completa se habilitará al finalizar.</div>
            {{/if}}
            {{#if creation.warnings.length}}<div class="tm-warning"><strong>Advertencias de legado</strong><ul>{{#each creation.warnings as |warning|}}<li>{{warning}}</li>{{/each}}</ul></div>{{/if}}
          </section>
        {{/if}}

        <div class="tm-v10-wizard-navigation">
          {{#if creationWizard.canBack}}<button type="button" data-action="creation-prev-step" data-step="{{creationWizard.step}}"><i class="fa-solid fa-arrow-left"></i> Anterior</button>{{else}}<span></span>{{/if}}
          {{#if creationWizard.isStep1}}<button type="button" data-action="creation-next-step" data-step="{{creationWizard.step}}" {{#unless creationWizard.ancestryReady}}disabled{{/unless}}>Continuar <i class="fa-solid fa-arrow-right"></i></button>{{/if}}
          {{#if creationWizard.isStep2}}<button type="button" data-action="creation-next-step" data-step="{{creationWizard.step}}" {{#unless creationWizard.originReady}}disabled{{/unless}}>Continuar <i class="fa-solid fa-arrow-right"></i></button>{{/if}}
          {{#if creationWizard.isStep3}}<button type="button" data-action="creation-next-step" data-step="{{creationWizard.step}}" {{#unless creationWizard.backgroundReady}}disabled{{/unless}}>Continuar <i class="fa-solid fa-arrow-right"></i></button>{{/if}}
          {{#if creationWizard.isStep4}}<button type="button" data-action="creation-next-step" data-step="{{creationWizard.step}}" {{#unless creationWizard.attributesReady}}disabled{{/unless}}>Continuar <i class="fa-solid fa-arrow-right"></i></button>{{/if}}
          {{#if creationWizard.isStep5}}<button type="button" data-action="creation-next-step" data-step="{{creationWizard.step}}" {{#unless creationWizard.developmentReady}}disabled{{/unless}}>Confirmar PD y continuar <i class="fa-solid fa-arrow-right"></i></button>{{/if}}
          {{#if creationWizard.isStep6}}<button type="button" data-action="creation-next-step" data-step="{{creationWizard.step}}" {{#unless creationWizard.traitsReady}}disabled{{/unless}}>Confirmar PR y continuar <i class="fa-solid fa-arrow-right"></i></button>{{/if}}
          {{#if creationWizard.isStep7}}<button type="button" data-action="creation-next-step" data-step="{{creationWizard.step}}" {{#unless creationWizard.equipmentReady}}disabled{{/unless}}>Confirmar equipo y continuar <i class="fa-solid fa-arrow-right"></i></button>{{/if}}
          {{#if creationWizard.isStep8}}<button type="button" class="tm-v10-complete-character" data-action="complete-creation" {{#unless creationWizard.reviewReady}}disabled{{/unless}}><i class="fa-solid fa-circle-check"></i> Completar personaje</button>{{/if}}
        </div>
      {{else}}
        <section class="tm-v03-page-hero">
          <i class="fa-solid fa-diagram-project"></i>
          <div><small>Página de desarrollo</small><h2>Desarrollo</h2><p>Nivel, PD, mejoras y reconstrucción autorizada.</p></div>
        </section>

        {{> "systems/tierra-magica/templates/actor/parts/item-section.hbs" title="Proyectos de fabricación e investigación" type="project" items=itemGroups.project}}

        <section class="tm-v03-development-summary">
          <div><span>Nivel</span><b>{{system.details.level}}</b>{{#if development.canAdvanceLevel}}<button type="button" data-action="advance-level">Subir de nivel (+4 PD)</button>{{/if}}</div>
          <div><span>Estado</span><b>{{creation.statusLabel}}</b></div>
          <div><span>PD totales</span><b>{{development.pdTotal}}</b></div>
          <div><span>PD gastados</span><b>{{development.pdSpent}}</b></div>
          <div class="tm-v03-pd-available"><span>PD disponibles</span><b>{{development.pdAvailable}}</b></div>
          <div><span>PR</span><b>{{development.prSpent}} / {{development.prTotal}}</b></div>
          <div><span>PD en Habilidades</span><b>{{development.skillsPdCost}}</b></div>
        </section>

        <section class="tm-panel tm-v03-page-panel tm-v10-identity-summary">
          <div class="tm-section-heading"><h2>Identidad</h2><span>Datos de creación, sin ocupar la cabecera de todas las páginas.</span></div>
          <div class="tm-v10-review-grid">
            <div><span>Ascendencia</span><b>{{identityItems.ancestry.name}}</b></div>
            <div><span>Origen</span><b>{{identityItems.origin.name}}</b><small>{{system.details.originFacet}}</small></div>
            <div><span>Trasfondo</span><b>{{identityItems.background.name}}</b><small>{{system.details.backgroundFacets}}</small></div>
            <div><span>Idiomas</span><b>{{system.traits.languages}}</b></div>
          </div>
          <div class="tm-section-buttons">{{#if creation.isComplete}}<button type="button" data-action="begin-rebuild">Abrir reconstrucción (DJ)</button>{{else}}<button type="button" data-action="complete-creation" {{#unless creationGuide.ready}}disabled{{/unless}}>Cerrar reconstrucción</button>{{/if}}</div>
        </section>

        {{#if isGM}}
          <details class="tm-v11-diagnostics-details">
            <summary><i class="fa-solid fa-stethoscope"></i><span>Diagnóstico técnico de derivados</span><small>DJ · fórmulas, fuentes y condicionales</small></summary>
            {{> "systems/tierra-magica/templates/actor/parts/derived-diagnostics.hbs"}}
          </details>
        {{/if}}

        {{#if creationGuide.ancestryProfile}}
          <section class="tm-panel tm-v03-page-panel">
            <div class="tm-section-heading"><h2>Paquete racial · {{creationGuide.ancestryProfile.name}}</h2><span>Escala {{creationGuide.ancestryScaleLabel}} · Movimiento {{creationGuide.ancestryProfile.movementBase}}{{#if creationGuide.ancestryProfile.movementModes}} · {{creationGuide.ancestryProfile.movementModes}}{{/if}}</span></div>
            {{#if creationGuide.ancestryProfile.features.length}}<ul>{{#each creationGuide.ancestryProfile.features as |feature|}}<li>{{feature}}</li>{{/each}}</ul>{{/if}}
          </section>
        {{/if}}

        <section class="tm-panel tm-v03-page-panel">
          <div class="tm-section-heading"><h2>Atributos</h2><span>{{#if creation.isRebuilding}}Reconstrucción: valores iniciales y progresión preservada.{{else}}Mejoras por PD; máximo ordinario 5.{{/if}}</span></div>
          <div class="tm-v03-attribute-editor">
            {{#if creation.isRebuilding}}
              {{#each system.attributes as |attribute key|}}<label><span>{{lookup ../config.attributes key}}</span><input type="number" data-action="set-creation-attribute" data-key="{{key}}" value="{{attribute.creationValue}}" min="1" max="3" /></label>{{/each}}
            {{else}}
              {{#each development.attributeUpgrades as |upgrade|}}<div><span>{{upgrade.label}}</span><b>{{upgrade.current}}</b>{{#if upgrade.canUpgrade}}<button type="button" data-action="upgrade-attribute" data-key="{{upgrade.key}}">Mejorar a {{upgrade.next}} · {{upgrade.cost}} PD</button>{{else}}<small>Máximo ordinario</small>{{/if}}</div>{{/each}}
            {{/if}}
          </div>
        </section>

        {{> "systems/tierra-magica/templates/actor/parts/item-section.hbs" title="Especializaciones" type="specialization" items=itemGroups.specialization}}
        {{> "systems/tierra-magica/templates/actor/parts/item-section.hbs" title="Técnicas" type="technique" items=itemGroups.technique}}
        {{> "systems/tierra-magica/templates/actor/parts/item-section.hbs" title="Disciplinas" type="discipline" items=itemGroups.discipline}}
        {{> "systems/tierra-magica/templates/actor/parts/item-section.hbs" title="Rasgos" type="trait" items=itemGroups.trait}}
      {{/if}}
    </div>

    <div class="tab" data-group="primary" data-tab="inventory">
      <section class="tm-v03-page-hero">
        <i class="fa-solid fa-backpack"></i>
        <div><small>Página de equipo</small><h2>Equipo</h2><p>Inventario, recursos y objetos transportados.</p></div>
      </section>
      <section class="tm-panel tm-currency tm-v03-page-panel">
        <div class="tm-section-heading">
          <h2>Moneda</h2>
          <span>Saldo líquido: <strong>{{currency.display}}</strong></span>
        </div>
        <div class="tm-currency-fields">
          <label>Oro <input type="number" min="0" step="1" data-action="currency-denomination" data-denomination="gold" value="{{currency.gold}}" /></label>
          <label>Plata <input type="number" min="0" step="1" data-action="currency-denomination" data-denomination="silver" value="{{currency.silver}}" /></label>
          <label>Cobre <input type="number" min="0" step="1" data-action="currency-denomination" data-denomination="copper" value="{{currency.copper}}" /></label>
        </div>
        <div class="tm-section-buttons tm-currency-actions">
          <button type="button" data-action="currency-add"><i class="fa-solid fa-plus"></i> Añadir</button>
          <button type="button" data-action="currency-spend"><i class="fa-solid fa-minus"></i> Gastar</button>
          {{#unless currency.initialReserveGranted}}<span>Reserva inicial: 2 o — se concede una sola vez al completar globalmente la creación.</span>{{/unless}}
        </div>
        {{#if creationPei.active}}
          <div class="tm-currency-creation">
            <strong>PEI restante: {{creationPei.display}}</strong>
            <span>Presupuesto de creación; no es dinero y el remanente se pierde.</span>
            <span>El PEI se cierra junto con la creación completa.</span>
          </div>
        {{/if}}
        {{#if currency.migrationPending}}
          <div class="tm-currency-migration">
            <strong>Migración monetaria pendiente.</strong>
            {{#if currency.hasLegacyCrowns}}
              <span>Dato preservado: {{currency.legacyCrowns}} crowns. No se convierte automáticamente.</span>
              <div class="tm-section-buttons">
                <button type="button" data-action="resolve-legacy-crowns">Convertir con equivalencia conocida</button>
                <button type="button" data-action="archive-legacy-crowns">Archivar sin convertir</button>
              </div>
            {{/if}}
          </div>
        {{/if}}
        <small>10 c = 1 p · 10 p = 1 o. Oro, plata y cobre son una presentación del mismo saldo.</small>
      </section>
      {{> "systems/tierra-magica/templates/actor/parts/item-section.hbs" title="Equipo e inventario" type="equipment" items=itemGroups.equipment}}
    </div>

    <div class="tab" data-group="primary" data-tab="biography">
      <section class="tm-v03-page-hero">
        <i class="fa-solid fa-feather"></i>
        <div><small>Página de historia</small><h2>Historia</h2><p>Biografía, notas y detalles del personaje.</p></div>
      </section>
      <section class="tm-panel tm-editor-panel tm-v03-page-panel"><h2>Historia</h2>{{editor enrichedBiography target="system.biography" button=true editable=editable engine="prosemirror" collaborate=false}}</section>
      <section class="tm-panel tm-editor-panel tm-v03-page-panel"><h2>Notas</h2>{{editor enrichedNotes target="system.notes" button=true editable=editable engine="prosemirror" collaborate=false}}</section>
    </div>
  </section>
</div>
</form>
